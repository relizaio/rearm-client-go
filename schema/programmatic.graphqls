}

type Branch {
  uuid: ID
  name: String
  component: ID
  componentDetails: Component
  components: [ID]
  status: Status
  type: BranchType
  vcs: ID
  vcsBranch: String
  dependencies: [ChildComponent]
  dependencyPatterns: [DependencyPattern]
  effectiveDependencies: [EffectiveDependency]
  org: ID
  versionSchema: String
  marketingVersionSchema: String
  versionType: VersionType
  metadata: String
  hasChildren: Boolean
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  autoIntegrate: AutoIntegrateState
  vcsRepositoryDetails: VcsRepository
  findingAnalyticsParticipation: FindingAnalyticsParticipation
}

input VersionFeatureSetOverride {
  componentUuid: ID
  vcsUri: String
  repoPath: String
  branch: String!
}

input SessionInitializeInput {
  """
  Display name the agent reports for itself ("Claude Code", "Cursor
  Agent"). Required -- used as the (org, lower(name)) lookup key.
  """
  agentName: String!
  """
  Model name the agent reports running ("claude-sonnet",
  "composer-1"). Required -- used as the (org, lower(name), version)
  lookup key on the ModelOntology row.
  """
  agentModel: String!
  """
  Model version (e.g. "4.5"). Defaults to "unknown" if omitted.
  """
  agentModelVersion: String
  """
  Publisher / vendor (e.g. "Anthropic"). Display-only; stored on the ModelOntology row.
  """
  agentVendor: String
  agentIconKind: String
  agentColor: String
  """
  Optional client-side session id. Defaults server-side to the row
  uuid when omitted. **Unique forever within (org, agent)**: an id
  previously used by ANY session (OPEN, CLOSED, or BLOCKED) cannot
  be re-used; sessionInitializeProgrammatic errors with
  clientSessionId-conflict. Agents that retry after a BLOCKED /
  CLOSED predecessor must mint a fresh id.
  """
  clientSessionId: String
  title: String
  """
  Optional pointer to a prior session this one continues from.
  Set when an agent retries after a BLOCKED or CLOSED predecessor
  so the audit trail threads the related attempts. Null on first-
  time sessions.
  """
  parentSession: ID
  """
  The agent tool's own id for the conversation opening this session, so the ReARM session
  can be traced back to it. Optional; the rearm CLI fills it in under Claude Code.
  """
  providerSession: ProviderSessionInput
  """
  What the client says about the device it runs on. Optional and self-reported; stored beside
  what the server observed, never in place of it. The rearm CLI sends it unless told not to.
  """
  device: SessionDeviceInput
}

"""
A client's description of its device. Each value is trimmed and clipped to 200 characters.
hostname is personal data and is shown only to org admins and the session's owner.
"""
input SessionDeviceInput {
  hostname: String
  os: String
  """
  The local UTC offset and zone abbreviation, e.g. "UTC+02:00 CEST".
  """
  timeZone: String
  """
  The client and its version, e.g. "rearm-cli/26.09.4".
  """
  client: String
}

"""
Upload one or more artifacts and bind them to an agent session.
Each {@code ArtifactInput.file} is a separate multipart part on the
HTTP body per the Apollo upload spec. The resulting artifact rows
carry {@code belongsTo=AGENT_SESSION} and live only on the session --
they do not appear on any release or component.
"""
input SessionAddArtifactInput {
  sessionUuid: ID!
  artifacts: [ArtifactInput!]!
}

input SessionUpdateMetaInput {
  uuid: ID!
  title: String
  clientSessionId: String
  """
  Record a provider session against an open session -- a conversation that resumes the work
  reports its own id here. Appends; a repeat of a recorded (provider, id) is a no-op, and may
  fill in a remoteId the first report lacked.
  """
  providerSession: ProviderSessionInput
}

"""
The agent tool's own session, as a client reports it. See Session.providerSessions.
"""
input ProviderSessionInput {
  """
  The tool, as a short lower-case identifier ("claude-code"). Stored lower-cased.
  """
  provider: String!
  """
  The tool's local id for the session -- for Claude Code, the id its transcript is filed
  under ($CLAUDE_CODE_SESSION_ID). Printable ASCII, no whitespace, at most 256 characters.
  """
  id: String!
  """
  The id a hosted surface of the tool knows the session by, when there is one -- for Claude
  Code, the bridge / web session id (session_...). Same character rules as id.
  """
  remoteId: String
}

"""
A coding agent registered to an org. ROOT agents are what an
external tool registers as and own sessions; SUB agents are
children a ROOT spawns and share the parent's session.

Identity = (org, lower(name)). Auto-registered on the first session
a calling FREEFORM key opens with a previously-unknown name in the
org. {@code model} points to a ModelOntology row carrying the
publisher / model / version / CycloneDX ML-BOM model card -- many
agents may share a model.
"""
type Agent {
  uuid: ID
  org: ID
  """
  Registration key supplied by the runtime via --agent-name. Part of
  the (org, agentIdentity, lower(name)) resolution key -- treat as
  immutable. User-facing renames go through displayName.
  """
  name: String
  """
  Optional admin-chosen label shown in the UI in place of name. Falls
  back to name when null. Cosmetic only -- never used for resolution
  or uniqueness.
  """
  displayName: String
  """
  Resolved label the UI should render. Precedence (strongest last):
  name → first bound FREEFORM key note → displayName. I.e.
  displayName if set, else the note on a bound FREEFORM key, else name.
  Read-only -- set displayName to override.
  """
  effectiveDisplayName: String
  """
  ModelOntology row this agent runs.
  """
  model: ModelOntology @deprecated(reason: "Model is a property of the chat, not the durable agent. Read Session.primaryModel instead; this returns the agent's last-seen declared model as a transitional fallback.")
  """
  Optional dashboard glyph.
  """
  iconKind: String
  """
  Optional dashboard accent colour (CSS hex).
  """
  color: String
  """
  Free-form notes the user sets on the dashboard.
  """
  notes: String
  """
  AgentIdentity row that scopes this agent. (org, agentIdentity,
  lower(name)) is the uniqueness boundary -- two different identities
  can each own a "Claude Code". SUB agents inherit their root's
  identity.
  """
  agentIdentity: ID
  status: AgentStatus
  agentType: AgentType
  """
  ROOT for top-level agents; SUB pointers point at the owning root.
  """
  rootAgent: ID
  """
  Direct children spawned by this agent (best-effort report).
  """
  subAgents: [ID]
  createdDate: DateTime
  """
  OPEN sessions owned by this ROOT agent. Empty list on SUB agents
  (sub-agents do not own sessions). Returns the same ordering as
  {@code sessionsOfAgent} -- most recently active first.
  """
  openSessions: [Session]
  """
  CLOSED sessions owned by this ROOT agent. Same ordering as
  {@code openSessions}.
  """
  closedSessions: [Session]
  """
  Open + closed session counts for this agent. Cheaper than walking
  the full lists when the dashboard only needs the badges.
  """
  sessionCounts: AgentSessionCounts
  """
  Most-recent activity timestamp across all sessions this agent
  owns. Drives the dashboard "connected" pill. Null when the agent
  has no sessions yet.
  """
  lastActivityAt: DateTime
  """
  Enrolled public keys this agent signs commits with. Includes
  revoked entries -- UI filters by revokedAt for display, the
  verifier filters at lookup time.
  """
  signingKeys: [SigningKey]
  """
  FREEFORM API keys bound to this agent's identity
  (agent_identity_credentials of type REARM_API_KEY). These are the
  keys an agent runtime authenticates with to drive this agent.
  """
  boundApiKeys: [ApiKey]
}

"""
Register a SUB agent under an existing parent. The parent may be
ROOT or SUB; the new sub's rootAgent is resolved to the parent's
owning root and its model ontology inherits from the parent unless
overridden.
"""
input SpawnSubAgentInput {
  parentUuid: ID!
  name: String!
  """
  Optional model-ontology override. Defaults to the parent's model.
  """
  modelUuid: ID
  iconKind: String
  color: String
}

"""
The kinds of work a model's strength can differ by. A board role maps to one of these through
AgentTaskRoleConfig.strengthCategory.
"""
enum ModelRoleCategory {
  ARCHITECT
  CODER
  QA
  REVIEWER
}

"""
A model's strength for one kind of work.
"""
type ModelRoleStrength {
  category: ModelRoleCategory!
  strength: Float!
}

"""
A role's strength override for one model.
"""
type RoleModelStrength {
  model: ID!
  strength: Float!
}

"""
One model's strength for one role, overriding what the catalogue says about the model.
"""
input RoleModelStrengthInput {
  """
  A model in this organization's catalogue.
  """
  model: ID!
  strength: Float!
}

"""
A row describing one AI/ML model an Agent runs. Identity =
(org, lower(name), version). Carries publisher + a full CycloneDX
ML-BOM model card (opaque jsonb). Auto-upserted on session
initialize from (agentVendor, agentModel, agentModelVersion).
"""
type ModelOntology {
  uuid: ID
  org: ID
  """
  Model name, e.g. "claude-sonnet".
  """
  name: String
  """
  Model version, e.g. "4.5". Defaults to "unknown" on auto-registration when omitted.
  """
  version: String
  """
  Publisher / vendor (e.g. "Anthropic"). Display-only.
  """
  publisher: String
  """
  One-line summary for the dashboard tooltip.
  """
  description: String
  """
  Optional canonical id (e.g. "pkg:huggingface/anthropic/claude-sonnet@4.5").
  """
  purl: String
  """
  CycloneDX ML-BOM model component (type machine-learning-model)
  stored opaquely. Empty {} on auto-registration; the user attaches
  a fuller card later via setModelOntologyModelCardProgrammatic.
  """
  modelCard: Object
  notes: String
  createdDate: DateTime
  """
  How capable this model is, on the organization's scale; null means unrated. Operator-set, never
  declared by an agent. At most two decimal places.
  """
  strength: Float
  """
  Per-category strengths, each overriding strength for roles of that category.
  """
  strengthByRole: [ModelRoleStrength!]
}

"""
Attach (or replace) a CycloneDX ML-BOM model card on an ontology
row. The card is the {@code component} object of a CycloneDX
machine-learning model -- see the
[CycloneDX ML-BOM guide](https://github.com/CycloneDX/guides/tree/main/ML-BOM/en)
for the expected shape.
"""
input SetModelCardInput {
  modelOntologyUuid: ID!
  modelCard: Object!
}

"""
An individual fielded unit -- the optional per-unit layer below a shipment.
Instance-like: plan (expected version) vs actual (phone-home) + 821 tracking.
"""
type Device {
  uuid: ID
  org: ID
  """
  Soft-delete marker: ARCHIVED rows are hidden from listings.
  """
  status: Status
  shippedProduct: ID
  site: ID
  """
  Unit-level identifiers (SERIAL, UDI, UDI-PI, ...).
  """
  identifiers: [Identifier]
  plan: DevicePlan
  actual: ActualReport
  tracking: TrackingRecord
  """
  Latest reconciled software state (digital twin, software side).
  """
  observedState: ObservedState
  notes: String
  """
  Computed: observed version diverges from the device's expected release.
  """
  versionDrift: Boolean
  createdDate: DateTime
  """
  The device support window that applies to this unit (D7): its shipment's override if
  that batch has one, else the product component's declaration, with the level it came
  from. This is the window the fleet evaluation measures the unit's software against.
  """
  effectiveDeviceSupportWindow: ResolvedDeviceSupportWindow
}

"""
Programmatic phone-home payload: observed digests (structured) and/or a raw
text blob (e.g. a k8s image list) the backend extracts digests from.
"""
input DeviceStateReportInput {
  device: ID!
  source: ReportSource
  observed: [ObservedDigestInput]
  rawText: String
}

"""
Enrolled public key bound to an Agent or Committer. The verifier
matches signatures by fingerprint to this row and never trusts the
key embedded in a signature blob.
"""
type SigningKey {
  uuid: ID
  org: ID
  format: SignatureFormat
  ownerType: SigningKeyOwnerType
  ownerUuid: ID
  """
  Normalised fingerprint -- SHA256:... for SSH, long key id for GPG.
  """
  fingerprint: String
  """
  Principal string ssh-keygen expects via -I, or GPG user-id.
  """
  identity: String
  """
  Wire-format pubkey -- single line SSH, ASCII-armoured GPG.
  """
  pubKey: String
  createdDate: DateTime
  revokedAt: DateTime
}

"""
Programmatic (FREEFORM-auth'd) variant of SigningKeyInput with no {@code org}
field: the org is always the one the calling key resolves to, so accepting a
client-supplied org is redundant and a footgun (a mismatched value previously
surfaced as an opaque "Not authorized"). Used only by
{@code enrollSigningKeyProgrammatic}.
"""
input AgentSigningKeyInput {
  format: SignatureFormat!
  ownerType: SigningKeyOwnerType!
  ownerUuid: ID!
  """
  SHA256:... for SSH; long key id for GPG. Derived from pubKey when omitted.
  """
  fingerprint: String
  """
  Optional override; defaults to the agent's identity where applicable.
  """
  identity: String
  """
  Single-line SSH or ASCII-armoured GPG block.
  """
  pubKey: String!
}

input AgentTaskRoleConfigInput {
  name: String!
  prompt: String
  orderIndex: Int
  wipLimit: Int
  requireDistinctAgent: Boolean
  active: Boolean
  requiredCapabilities: [AgentCapability!]
  """
  Operator-only; rejected on the coordinator-seat path.
  """
  kind: AgentRoleKind
  """
  Operator-only; rejected on the coordinator-seat path.
  """
  necessity: AgentRoleNecessity
  """
  Operator-only; rejected on the coordinator-seat path.
  """
  humanGate: AgentHumanGate
  """
  Operator-only. The floor a model must meet for this role, at most two decimal places. Left
  out, unchanged; sent as null, the floor is removed.
  """
  requiredStrength: Float
  """
  Operator-only. How far above requiredStrength a model may be; 0 is an exact match.
  """
  strengthHeadroom: Float
  """
  Operator-only. Which of a model's per-category strengths this role reads; null reads the base.
  """
  strengthCategory: ModelRoleCategory
  """
  Operator-only. Replaces the role's per-model overrides; an empty list clears them.
  """
  modelStrengths: [RoleModelStrengthInput!]
}

input AgentTaskRegisterInput {
  boardUuid: ID!
  externalRef: String
  title: String!
  sourceUrl: String
  """
  Registering agent's session (intake provenance).
  """
  sessionUuid: ID
  parentTask: ID
}

enum AgentBoardEventKind {
  LOCKED
  UNLOCKED
  ALERT
  INFO
}

input AgentTaskSplitChildInput {
  externalRef: String
  title: String!
  sourceUrl: String
  """
  Sibling-index dependencies (0-based within this split), encoding the architect's proposed ordering.
  """
  dependsOnSiblingIndexes: [Int!]
}

enum AgentSignOffOutcome {
  PASSED
  REJECTED
}

"""
Why an assigned agent handed the task back to the coordinator. SESSION_CLOSED is system-generated on any session-close path.
"""
enum AgentTaskReturnReason {
  TASK_UNCLEAR
  ROLE_MISMATCH
  MISSING_CAPABILITY
  BLOCKED_ON_DEPENDENCY
  NEEDS_HUMAN
  SESSION_CLOSED
  OTHER
}

"""
Ownership slice a declarative spec describes. One kind per file; the apply / export operations are per kind.
"""
enum DeclarativeKind {
  CATALOG
  BRANCHES
}

type CatalogComponent {
  name: String!
  type: ComponentType!
  kind: ComponentKind
  versionSchema: String
  marketingVersionSchema: String
  versionType: VersionType
  featureBranchVersioning: String
  vcsUri: String
  vcsType: String
  repoPath: String
  nature: ComponentNature
  deviceClass: DeviceClass
  branchSuffixMode: BranchSuffixMode
  identifiers: [Identifier!]
  provenance: DeclarativeProvenance
}

type BranchSpecEntry {
  name: String!
  type: BranchType
  versionSchema: String
  marketingVersionSchema: String
  vcsBranch: String
  autoIntegrate: AutoIntegrateState
  findingAnalyticsParticipation: FindingAnalyticsParticipation
  dependencies: [DependencySpec!]
  dependencyPatterns: [DependencyPattern!]
  provenance: DeclarativeProvenance
}

enum Status {
  ACTIVE
  APPROVED
  ARCHIVED
  COMPLETE
  DRAFT
  IGNORED
  JOB
  OPTIONAL
  PENDING
  REJECTED
  REQUIRED
  TRANSIENT
}

enum ReleaseLifecycleEnum {
  CANCELLED
  REJECTED
  PENDING
  DRAFT
  ASSEMBLED
  READY_TO_SHIP
  GENERAL_AVAILABILITY
  END_OF_MARKETING
  END_OF_DISTRIBUTION
  END_OF_SUPPORT
  END_OF_LIFE
}

type Organization {
  uuid: ID
  name: String
  type: OrganizationType
  approvalRoles: [ApprovalRole]
  terminology: Terminology
  ignoreViolation: IgnoreViolation
  settings: Settings
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  """
  Org-wide PR-validation trigger rules. Each rule maps a regex over
  {@code VcsRepository.uri} (matched fully-anchored, see {@link
  GlobalPrValidationTriggerRule.uriPattern}) to an EXTERNAL_VALIDATION
  trigger that should apply when a VCS in the org has no per-repo
  override. List order is the priority order -- the first matching
  rule wins, and the per-VCS resolver surfaces the losing rule names
  for operator clean-up. SAAS-only.
  """
  globalPrValidationTriggerRules: [GlobalPrValidationTriggerRule]
  """
  Org-wide approval-policy assignment rules. Each rule maps a regex
  over {@code Component.name} (matched fully-anchored) plus a
  {@code componentType} filter to an approval-policy UUID. When a
  component has no per-component policy reference (or it points to
  an archived/missing policy), the resolver walks this list in order
  and the first matching rule's policy becomes the effective policy.
  List order is the priority order -- first match wins; the per-
  Component resolver surfaces the losing rule names for operator
  clean-up. SAAS-only.
  """
  globalApprovalPolicyRules: [GlobalApprovalPolicyRule]
  """
  Org-wide team-assignment rules. Each rule maps a regex over
  {@code Component.name} (matched fully-anchored) plus a
  {@code componentType} filter to an owner team. When a component has no
  per-component owner, the resolver walks this list in order and the first
  matching rule's team becomes the component's durable owner -- the result
  is flagged derived and names the rule, so the UI can distinguish "someone
  chose this" from "a pattern matched". A per-component owner always wins.
  List order is the priority order -- first match wins.
  """
  globalTeamAssignmentRules: [GlobalTeamAssignmentRule]
}

type ParentRelease {
  org: ID
  release: ID
  releaseDetails: Release
}

type SourceCodeEntry {
  uuid: ID
  branch: ID
  vcsUuid: ID
  vcsBranch: String
  vcsRepository: VcsRepository
  commit: String
  commits: String
  commitMessage: String
  commitAuthor: String
  commitEmail: String
  vcsTag: String
  notes: String
  org: ID
  dateActual: DateTime
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  artifacts: [ID]
  artifactDetails: [Artifact]
  """
  Resolved AgentSession this commit was authored under, or null on
  non-agent commits / unresolved trailers. Set by the PR 2
  commit-trailer parser from ReARM-Agentic-Session: on the commit
  message.
  """
  agentSession: ID
  """
  Leaf agent that authored the commit (may be a SUB; the session's
  {@code agent} is always the ROOT). Set by the PR 2 commit-trailer
  parser from ReARM-Agent: on the commit message.
  """
  agent: ID
  """
  Releases whose primary SCE is this commit. Typically 0 or 1, but
  rebuilds against the same commit produce multiple entries. Each
  release is the natural place the UI can jump to from a commit row.
  """
  releases: [Release]
  """
  Latest signature-verification verdict for this commit (or null when
  no signature artifact has been attached). Backed by the
  signature_verifications row pointed at by this SCE -- read-time
  pick of the most-recent verdict for (SCE, subjectUuid). Used by
  CEL via {@code commit.signature.*}.
  """
  signature: SceSignature
  """
  Outcome of the agent-attribution trailer resolution for this commit.
  UNATTRIBUTED on non-agent commits; RESOLVED when both trailers parsed
  and the agent / session were found; REJECTED when the trailers were
  present but the claim could not be resolved (malformed clientSessionId,
  unknown agent / session, cross-org, etc.). Used by CEL via
  {@code commit.attribution.state} -- symmetric with
  {@code commit.signature.state} for the unsigned-commit gate.
  """
  attributionState: AttributionState
  """
  Human-readable reason explaining a REJECTED attribution. Null on
  UNATTRIBUTED and RESOLVED.
  """
  attributionReason: String
}

scalar DateTime

type Artifact {
  uuid: ID
  displayIdentifier: String
  """
  Whether the artifact bytes live inside ReARM's blob store (REARM)
  or only as external download links (EXTERNALLY). UI uses this to
  decide whether to render an in-place download button.
  """
  storedIn: ArtifactStoredIn
  org: ID
  branch: ID
  buildId: String
  buildUri: String
  cicdMeta: String
  digestRecords: [DigestRecord]
  isInternal: ArtifactBelonging
  type: ArtifactType
  bomFormat: BomFormat
  specVersion: SpecVersion
  serializationFormat: SerializationFormat
  notes: String
  tags: [TagRecord]
  tagRecords: [TagRecord]
  dateFrom: DateTime
  dateTo: DateTime
  duration: Long
  packageType: PackageType
  version: String
  publisher: String
  group: String
  dependencies: [ID]
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  internalBom: InternalBom
  downloadLinks: [Downloadlink]
  metrics: DependencyTrackMetrics
  componentUuid: ID
  artifacts: [ID]
  artifactDetails: [Artifact]
  enrichmentStatus: EnrichmentStatus
  vexImportSummary: VexImportSummary
}

type Deliverable {
  uuid: ID
  name: String
  org: ID
  displayIdentifier: String
  branch: ID
  type: String
  notes: String
  tags: [TagRecord]
  version: String
  publisher: String
  group: String
  supportedOs: [OSEnum]
  supportedCpuArchitectures: [CPUArchitectureEnum]
  softwareMetadata: SoftwareMetadata
  hardwareMetadata: HardwareMetadata
  quantity: Int
  artifacts: [ID]
  artifactDetails: [Artifact]
  identifiers: [Identifier]
}

type Ticket {
  uuid: ID
  identifier: String
  status: TicketStatus
  org: ID
  summary: String
  content: String
  doneInRelease: ID
  dateDone: DateTime
  uri: String
}

enum ProgrammaticType {
  MANUAL
  AUTO
  MANUAL_AND_AUTO
  API
  TEST
}

type VcsRepository {
  uuid: ID
  name: String
  org: ID
  uri: String
  type: String
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  """
  Pull-request-level output triggers for this VCS repository. Currently
  constrained to ≤1 entry of type EXTERNAL_VALIDATION -- used by the PR
  aggregator to dispatch the aggregated check-run verdict to the SCM.
  """
  outputTriggers: [ReleaseOutputEvent]
  """
  Resolved PR-validation trigger for this repo. Per-repo
  {@code outputTriggers} always wins; otherwise the org-wide rule
  list is walked in order and the first match's trigger is returned.
  {@code source} discriminates between the two; {@code ruleName} is
  set only when source = ORG_RULE; {@code alsoMatchedRuleNames}
  carries any later-list rules whose pattern also matched (for the
  provenance UI's "rules X, Y also match; X wins" warning);
  {@code staleRuleNames} flags rules that matched but reference a
  missing/archived integration and were therefore skipped.
  """
  effectivePrValidationTrigger: EffectivePrValidationTrigger
}

type TagRecord {
  key: String
  value: String
  removable: RemvovableType
}

type ReleaseApprovalEvent {
  approvalEntry: ID
  approvalEntryName: String
  approvalRoleId: ID
  state: ApprovalState
  date: DateTime
  wu: WhoUpdated
  """
  Optional free-form approver comment, sanitised server-side via
  jsoup's Safelist.basic() (allows simple inline tags, strips
  scripts/styles/event handlers). Capped at 4000 chars at the input
  boundary; empty-after-clean is normalised to null.
  """
  comment: String
}

"""
One approval request recorded on a release (requestReleaseApprovals).
`resolvedAt` is stamped when every requested entry has reached a terminal
state (satisfied or disapproved); null while the request is open.
"""
type ReleaseApprovalRequest {
  uuid: ID
  requestedBy: ID
  approvalEntries: [ID!]
  requestedAt: DateTime
  resolvedAt: DateTime
}

type Variant {
  uuid: ID
  identifier: String
  identifierPrefix: String
  order: Int
  version: String
  marketingVersion: String
  sku: String
  type: VariantType
  org: ID
  orgDetails: Organization
  release: ID
  outboundDeliverables: [ID]
  outboundDeliverableDetails: [Deliverable]
  notes: String
  endpoint: String
  tags: [TagRecord]
}

type ReleaseUpdateEvent {
  rus: ReleaseUpdateScopeEnum
  rua: ReleaseUpdateActionEnum
  oldValue: String
  newValue: String
  objectId: ID
  """
  Human-readable reason for this event, populated when the
  change carries context the oldValue/newValue tuple cannot
  convey on its own. For LIFECYCLE events fired by a
  component-level CEL input trigger, this carries the trigger
  name and the CEL expression that matched. null for events
  whose meaning is fully captured by the structural fields.
  """
  message: String
  date: DateTime
