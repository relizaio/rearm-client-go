input OriginShareInput {
  originCode: String
  percentage: Float
}

enum PermissionScope {
  ORGANIZATION
  INSTANCE
  PERSPECTIVE
  COMPONENT
  BRANCH
  RELEASE
}

enum PermissionType {
  ADMIN
  READ_ONLY
  READ_WRITE
  ESSENTIAL_READ
  NONE
}

enum PermissionFunction {
  RESOURCE
  FINDING_ANALYSIS_READ
  FINDING_ANALYSIS_WRITE
  ARTIFACT_DOWNLOAD
  SBOM_PROBING
  LIFECYCLE_UPDATE
  DEVOPS_READ
  DEVOPS_WRITE
  VERSION_FEATURESET
  AGENT
  DISTRIBUTION
  """
  Export declarative configuration (Catalog, Branches) through the programmatic API.
  """
  CONFIGURATION_READ
  """
  Apply declarative configuration through the programmatic API; implies CONFIGURATION_READ.
  """
  CONFIGURATION_WRITE
}

type Coords {
  latitude: Float
  longitude: Float
}

input CoordsInput {
  latitude: Float
  longitude: Float
}

