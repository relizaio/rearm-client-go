# ReARM programmatic API contract: the root fields declared in programmatic.graphqls and
# every type they reach, whether declared there or in the shared schema.
# served at /api/programmatic/schema. Consumed by rearm-client-go and the Terraform provider.

type Query {
  """
  Export the Catalog slice of the key's org as a spec (CONFIGURATION_READ); optionally only the named components.
  """
  exportCatalogProgrammatic(
  components: [String!]): CatalogSpec
  """
  Export the Branches slice of one component / product as a spec (CONFIGURATION_READ).
  """
  exportBranchesProgrammatic(
  component: String!): BranchesSpec
  """
  Export one board of the key's organization as a board file, by name or uuid (CONFIGURATION_READ).
  """
  exportBoardProgrammatic(
  board: String!): BoardSpec
  """
  Export the key's organization's role presets as a presets file (CONFIGURATION_READ).
  """
  agentRolePresetsSpecProgrammatic: RolePresetsSpec
  release(releaseUuid: ID!, orgUuid: ID): Release
  getSbomProbingResult(runId: String!): SbomProbingResult
  getReleaseByHashProgrammatic(hash: String!, componentId: ID): String
  """
  Exact-version lookup. Returns the release's OBOM (CycloneDX 1.6: the release
  plus every dependency release unwound, with deliverables) as a JSON string,
  or "{}" when the version does not exist on the component / product.
  Lifecycle and approvals are not consulted: the named version is returned as is.
  componentId is the component / product uuid, or -- with an organization-scoped
  key -- its name: matched case-insensitively against the org's active components
  and products, exactly one hit required (unknown or ambiguous names error).
  """
  getReleaseByReleaseVersionProgrammatic(
  version: String!
  componentId: ID!): String
  getLatestReleaseProgrammaticCdx(release: GetLatestReleaseInput!): String
  getLatestReleaseProgrammatic(release: GetLatestReleaseInput!): Release
  getInstanceRevisionCycloneDxExportProg(instanceUuid: ID, instanceUri: String, revision: Int!, namespace: String, stateType: InstanceStateType): String
  isInstanceHasSealedSecretCert(instanceUuid: ID, instanceUri: String): Boolean
  getInstancePropSecrets(instanceUuid: ID, instanceUri: String, namespace: String!, revision: Int!, properties: [String], secrets: [String], product: ID, productSpecificProps: Boolean): PropSecrets
  deliverableDownloadSecrets(instanceUuid: ID, instanceUri: String, deliverableDigest: String!, namespace: String, releaseNs: String): ComponentAuthentication
  listInstanceProductFeatureSets(instanceUuid: ID, instanceUri: String, namespace: String): [InstanceProductFeatureSets!]!
  """
  Programmatic poll endpoint for an agent's session -- returns
  actionable events (lifecycle changes on attributed releases,
  approval flips, new session policy verdicts) strictly after the
  supplied cursor. Auth: FREEFORM key bound to the session's owning
  agent identity. Designed for closed-loop "disapproval → agent
  fix" flows; see {@code /api/agents/orientation.md} for the
  canonical polling cadence.
  """
  agentSessionInboxProgrammatic(
  inboxRequest: AgentSessionInboxInput!): [AgentSessionInboxEvent!]!
  """
  FREEFORM-auth read of a single session by uuid. Returns null when
  the session does not exist or is owned by a different org than the
  calling key. The JWT-authenticated {@code session} query is the
  operator/UI path; this is the agent's path for fetching its own
  full session state (policy verdicts, releases, PRs) after an inbox
  event.
  """
  sessionProgrammatic(
  sessionUuid: ID!): Session
  """
  FREEFORM-auth read of a single release by uuid, scoped to the
  calling agent's session. The caller must pass either {@code
  sessionUuid} (the row uuid returned by {@code sessionInitializeProgrammatic})
  or {@code clientSessionId} (the agent-chosen id). Authorization
  chain: (a) calling key carries {@code PermissionFunction.AGENT}
  at {@code ORGANIZATION} scope; (b) the session's owning agent
  belongs to the calling key's identity; (c) the requested release
  is attributed to that session (its commits trace through to this
  release). Any failure throws {@code AccessDeniedException} and
  is logged SECURITY-level. Used by agents after a LIFECYCLE_CHANGE
  / APPROVAL inbox event to pull updateEvents + approvalEvents on
  the release.
  """
  agenticReleaseProgrammatic(
  releaseUuid: ID!
  sessionUuid: ID
  clientSessionId: String): Release
  """
  Agent-key auth (FREEFORM, personal USER or FEDERATED): the org's boards (coordinator/worker discovery).
  """
  agentBoardsProgrammatic: [AgentBoard]
  """
  Every task on one board with who holds it, what it waits on, its current documents and the
  question it is waiting on. One call, so an agent can see what the others are doing without
  N round trips -- an agent that has to ask N questions will not ask them.
  """
  agentBoardSnapshotProgrammatic(
  boardUuid: ID!): AgentBoardSnapshot
  """
  Agent-key auth: one board (includes coordinatorPrompt and lock state).
  """
  agentBoardProgrammatic(
  boardUuid: ID!): AgentBoard
  """
  Worker poll: the lowest-ordered QUEUED task across the org's
  unlocked boards (or one board) whose constraints admit the calling
  session's agent (WIP limits, distinct-agent, seat exclusion).
  Returns the role to assume and its served prompt; the agent follows
  up with agentTaskAssignProgrammatic. Null = no work.
  
roles: the roles this agent can take, each a role name on the board
  (case-insensitive) or a role config uuid. Omitted or empty, every
  role is considered. Given, only tasks for those roles are offered;
  when none match, or nothing is open for them, the answer is null.
  Pass the same roles to agentTaskAssignProgrammatic.
  """
  agentTaskNextProgrammatic(
  sessionUuid: ID!
  boardUuid: ID
  roles: [String!]): AgentTaskAssignment
  """
  Agent-key auth: read one task.
  """
  agentTaskProgrammatic(
  taskUuid: ID!): AgentTask
  """
  Agent-key auth: tasks of a board, optionally by status.
  """
  agentTasksProgrammatic(
  boardUuid: ID!
  status: AgentTaskStatus): [AgentTask]
  """
  Agent-key auth: a board's role configuration in order.
  """
  agentTaskRoleConfigsProgrammatic(
  boardUuid: ID!): [AgentTaskRoleConfig]
  """
  Agent-key auth: the board as a declarative spec.
  """
  agentBoardSpecProgrammatic(
  boardUuid: ID!): BoardSpec
}

type Mutation {
  """
  Declarative apply of the Catalog slice (API key, write access on the org). Idempotent, keyed by
  component name. dryRun computes the change set without writing.
  """
  applyCatalogProgrammatic(
  spec: CatalogSpecInput!
  dryRun: Boolean
  source: DeclarativeSourceInput): DeclarativeApplyResult
  """
  Declarative apply of the Branches slice for one component / product (API key, write access on the
  org). Idempotent, keyed by branch name. Branches absent from the spec follow Settings.declarativePrune.
  """
  applyBranchesProgrammatic(
  spec: BranchesSpecInput!
  dryRun: Boolean
  source: DeclarativeSourceInput): DeclarativeApplyResult
  """
  Apply one board file (CONFIGURATION_WRITE with write access on the org). One transaction:
  any problem refuses the whole file, and the result lists every problem found. A dry run returns
  the change set the apply would and writes nothing.
  """
  applyBoardProgrammatic(
  spec: BoardSpecInput!
  dryRun: Boolean
  source: DeclarativeSourceInput): DeclarativeApplyResult
  """
  Apply the organization's presets file (CONFIGURATION_WRITE); the board's rules, per preset.
  """
  applyRolePresetsProgrammatic(
  spec: RolePresetsSpecInput!
  dryRun: Boolean
  source: DeclarativeSourceInput): DeclarativeApplyResult
  """
  Archive a board by name (CONFIGURATION_WRITE): what deleting a Terraform board does. Tasks, roles
  and history stay; the board takes no new work. Archiving an archived board changes nothing.
  """
  archiveBoardProgrammatic(
  name: String!): AgentBoard
  """
  Programmatic (API-key) upsert of a PullRequest. CI registers the PR
  row independently of release creation so the registration survives
  push/pull_request races and DO_BUILD=false short-circuits.
  Idempotent on (targetVcsRepository, identity) -- safe to call
  multiple times per CI run (e.g. once per component in a monorepo).
  When `commit` is supplied and an SCE already exists for
  (targetVcs, commit), the head is advanced to that SCE in the same
  call; otherwise the PR row is registered without a head and the
  subsequent addReleaseProgrammatic call (which carries the same PR
  input) will advance the head once the SCE is persisted.
  Resolves the target VCS by `vcsUri`+`repoPath` (FREEFORM or
  ORGANIZATION_RW key) or by `component` UUID (COMPONENT,
  FREEFORM, or ORGANIZATION_RW key). Accepts COMPONENT, FREEFORM,
  or ORGANIZATION_RW API keys; other ORGANIZATION_* types are
  rejected.
  """
  upsertPullRequestProgrammatic(
  input: PullRequestUpsertProgrammaticInput!): PullRequest
  getNewVersionProgrammatic(newVersionInput: GetNewVersionInput!): Version
  """
  Claim or disown a commit as the key's agent. The commit is named the way getversion and
  addrelease name a component -- a component uuid, or vcsUri plus repoPath -- plus the sha,
  which the server resolves through that component's repository. A sha ReARM has never seen is
  refused rather than recorded: a commit that does not exist cannot be a lock cause.
  
The session is required rather than inferred from the key: an attestation says who stood
  behind a claim, and a key is not a who. An agent already opens a session before it works, so
  it has one to name.
  
This is the mutation a refusal points at. An agent that made a mistake claims it, and if
  that was the last thing a lock was waiting on and the lock is allowed to release itself, the
  next build goes through with no human in the loop.
  """
  attestProgrammatic(
  componentRef: ComponentRefInput!
  commit: String!
  verdict: AttestationVerdict!
  note: String
  session: ID!): Attestation
  """
  Release a lock whose level is AGENT and whose requirement is met. Anything stricter, or any
  lock that has escalated, refuses and says so.
  
The session is required and must belong to the calling key's agent: the LOCK_RELEASE
  attestation this writes is the durable record of who released the lock.
  """
  releaseLockProgrammatic(
  lockUuid: ID!
  reason: String!
  session: ID!): Lock
  addReleaseProgrammatic(release: ReleaseInputProg!): Release
  """
  Batch counterpart to addReleaseProgrammatic. Creates every supplied
  release in a single all-or-nothing transaction -- if any entry fails,
  none are persisted. Auto-integration of products is deferred until all
  releases are created, then fired once per affected feature set (deduped
  across the whole batch) instead of once per release. Use this when a CI
  run builds several component releases at once and you want a single
  product auto-integrate rather than one per component version.
  """
  addReleasesProgrammatic(
  releases: [ReleaseInputProg!]!): [Release]
  addOutboundDeliverablesProgrammatic(deliverables: AddODeliverableInput!): Release
  createComponentProgrammatic(component: CreateComponentInput!): Component
  """
  Programmatic counterpart to createComponentInPerspective. Requires a FREEFORM API key
  with WRITE permission on the supplied perspective (or a broader scope that covers it).
  Only real perspectives (PerspectiveType.PERSPECTIVE) are accepted -- product-derived
  perspectives are rejected.
  """
  createComponentInPerspectiveProgrammatic(
  component: CreateComponentInput!
  perspectiveUuid: ID!): Component
  addArtifactProgrammatic(artifactInput: AddArtifactInput): Release
  approveReleaseProgrammatic(releaseApprovals: ReleaseApprovalProgrammaticInput!): Release
  synchronizeLiveBranches(synchronizeBranchInput: SynchronizeBranchInput!): Boolean
  probeSbomProgrammatic(sbom: String!, componentUuid: ID, branchUuid: ID): SbomProbingRun
  releasecompletionfinalizerProgrammatic(release: ID!): Boolean
  instData(instance: InstanceDataInput!): Object
  instanceDeploymentEventsProgrammatic(events: [InstanceDeploymentEventInput!]!): Object
  setInstanceSealedSecretCert(sealedCert: String!): Boolean
  """
  Switch a product deployment on the instance plan to another feature set of the same product.
  release: optional release uuid or version on the new feature set; pins the deployment to it
  (the plan entry becomes TARGET). follow: optional, true returns the entry to FOLLOW. Without
  either, the integrate type is kept and the previous target release is cleared.
  """
  switchInstanceProductFeatureSet(
  instanceUuid: ID
  instanceUri: String
  productUuid: ID!
  featureSetUuid: ID!
  namespace: String
  release: String
  follow: Boolean): Instance
  versionFeatureSet(productUuid: ID!, overrides: [VersionFeatureSetOverride!]!): Branch
  sessionInitializeProgrammatic(sessionInit: SessionInitializeInput!): Session
  sessionTouchProgrammatic(sessionUuid: ID!, usage: SessionUsageReportInput): Session
  sessionReportUsageProgrammatic(input: SessionUsageReportInput!): SessionUsageAck
  sessionCloseProgrammatic(sessionUuid: ID!): Session
  sessionAddArtifactProgrammatic(addArtifact: SessionAddArtifactInput!): Session
  sessionUpdateMetaProgrammatic(updateMeta: SessionUpdateMetaInput!): Session
  spawnSubAgentProgrammatic(spawnSubAgent: SpawnSubAgentInput!): Agent
  setModelOntologyModelCardProgrammatic(input: SetModelCardInput!): ModelOntology
  reportDeviceState(report: DeviceStateReportInput!): Device
  enrollSigningKeyProgrammatic(signingKey: AgentSigningKeyInput!): SigningKey
  agentBoardCoordinateProgrammatic(boardUuid: ID!, sessionUuid: ID!): AgentBoard
  agentBoardCoordinatorLockProgrammatic(boardUuid: ID!, sessionUuid: ID!, lock: Boolean!, reason: String): AgentBoard
  agentTaskRoleConfigSetProgrammatic(boardUuid: ID!, sessionUuid: ID!, input: AgentTaskRoleConfigInput!): AgentTaskRoleConfig
  agentTaskRegisterProgrammatic(input: AgentTaskRegisterInput!): AgentTask
  """
  requiredStrength: raise the model strength this task needs above what its role usually asks,
  for work harder than the role usually is. Raise only: at least the task's current requirement
  (its override, else the role's floor); lower values and null are refused -- people lower it
  through agentTaskSetStrength. At most two decimal places. Left out, unchanged.
  """
  agentTaskAuthorizeProgrammatic(
  taskUuid: ID!
  sessionUuid: ID!
  role: String!
  orderIndex: Int
  dependsOn: [ID!]
  producesComponent: ID
  level: Int
  requiredInputs: [AgentRequiredInputInput]
  requiredStrength: Float): AgentTask
  agentTaskHoldProgrammatic(taskUuid: ID!, sessionUuid: ID!, reason: String!): AgentTask
  agentTaskReleaseHoldProgrammatic(taskUuid: ID!, sessionUuid: ID!): AgentTask
  """
  Coordinator sets the per-task human-review flag (add-only: the coordinator can add review, never remove it).
  """
  agentTaskRequireHumanReviewProgrammatic(
  taskUuid: ID!
  sessionUuid: ID!): AgentTask
  agentBoardPostEventProgrammatic(boardUuid: ID!, sessionUuid: ID!, kind: AgentBoardEventKind!, message: String!): AgentBoard
  agentTaskOrderProgrammatic(taskUuid: ID!, sessionUuid: ID!, orderIndex: Int!): AgentTask
  agentTaskSplitProgrammatic(taskUuid: ID!, sessionUuid: ID!, children: [AgentTaskSplitChildInput!]!): [AgentTask]
  agentTaskCompleteProgrammatic(taskUuid: ID!, sessionUuid: ID!, note: String): AgentTask
  agentTaskCancelProgrammatic(taskUuid: ID!, sessionUuid: ID!, note: String): AgentTask
  """
  Coordinator: send a COMPLETED task back to an active role, with a reason -- its delivery cannot
  land, e.g. its PR no longer merges. The role's earlier passes stop counting; whoever read its
  part re-runs when the redone hop republishes. Refused on a cancelled task (register a new one)
  and on a locked board; a round the budget does not cover holds for an operator.
  """
  agentTaskReopenProgrammatic(
  taskUuid: ID!
  sessionUuid: ID!
  role: String!
  reason: String!): AgentTask
  """
  roles: the roles this agent declared on agentTaskNextProgrammatic, if any. A task for any
  other role is refused, and on a STRICT board priority is enforced among these roles only.
  """
  agentTaskAssignProgrammatic(
  taskUuid: ID!
  sessionUuid: ID!
  roles: [String!]): AgentTaskAssignment
  agentTaskSignOffProgrammatic(taskUuid: ID!, sessionUuid: ID!, outcome: AgentSignOffOutcome!, note: String, outputs: [ID!]): AgentTask
  agentTaskReturnProgrammatic(taskUuid: ID!, sessionUuid: ID!, reason: AgentTaskReturnReason!, description: String, outputs: [ID!]): AgentTask
  agentDocumentPublishProgrammatic(input: AgentDocumentPublishInput!): Release
  agentTaskBindExternalRefProgrammatic(taskUuid: ID!, externalRef: String!, sourceUrl: String): AgentTask
  agentTaskLinkPrProgrammatic(taskUuid: ID!, prUrl: String!): AgentTask
  """
  Attach a release this task produced -- the release counterpart of linkPr, and what a downstream role waits on when it requires this task's output.
  """
  agentTaskLinkReleaseProgrammatic(
  taskUuid: ID!
  releaseUuid: ID!): AgentTask
}

type CatalogSpec {
  kind: DeclarativeKind!
  version: Int!
  authoritative: Boolean!
  components: [CatalogComponent!]!
}

type BranchesSpec {
  kind: DeclarativeKind!
  version: Int!
  component: String!
  authoritative: Boolean!
  branches: [BranchSpecEntry!]!
}

"""
A board as configuration: enough to stand the same board up elsewhere, and no runtime state.
"""
type BoardSpec {
  kind: DeclarativeKind!
  version: Int!
  name: String
  description: String
  """
  Name of the component this board builds -- a spec is portable, so names rather than uuids.
  """
  target: String
  defaultTaskLevel: Int
  defaultInputResolution: AgentInputResolution
  priorityType: AgentBoardPriorityType
  perAgentWipLimit: Int
  sources: [String]
  """
  Where documents are written, as the repository URI rather than the row uuid: a spec
  is portable, and the uuid of a repository row means nothing in another organization.
  Applying resolves it the same way agentBoardUpdate does.
  """
  documentsRepo: String
  """
  Per-type path templates, keyed by SpecificationType. Omitted types use the defaults by scope.
  """
  documentPaths: Object
  coordinatorPrompt: String
  """
  Verbs the coordinator seat performs itself (PR_MERGE, CODE_PUSH); absent means only the tracker verbs.
  """
  coordinatorCapabilities: [AgentCapability!]
  """
  The board's budget and stops; a null value is the board default.
  """
  settings: BoardSettingsSpec
  roles: [BoardRoleSpec]
}

"""
An organization's role presets as one file. Presets seed every new board's roles.
"""
type RolePresetsSpec {
  kind: DeclarativeKind!
  version: Int!
  authoritative: Boolean
  presets: [BoardRoleSpec]
}

type Release {
  uuid: ID
  version: String
  marketingVersion: String
  status: Status
  lifecycle: ReleaseLifecycleEnum
  """
  Computed (Distribution): true when this release's component is HARDWARE, or --
  for a product release -- when at least one constituent component release is.
  """
  hardware: Boolean
  org: ID
  orgDetails: Organization
  component: ID
  componentDetails: Component
  branch: ID
  branchDetails: Branch
  parentReleases: [ParentRelease]
  sourceCodeEntry: ID
  sourceCodeEntryDetails: SourceCodeEntry
  commits: [ID]
  commitTime: DateTime
  commitsDetails: [SourceCodeEntry]
  """
  Pull requests this release participates in -- any PR whose commits[]
  intersects this release's commits[]. Computed at read time; resolves
  by matching SCE UUIDs.
  """
  pullRequests: [PullRequest]
  artifacts: [ID]
  artifactDetails: [Artifact]
  inboundDeliverables: [ID]
  inboundDeliverableDetails: [Deliverable]
  tickets: [ID]
  ticketDetails: [Ticket]
  notes: String
  decoratedVersionString: String
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  endpoint: String
  inProducts: [Release]
  vcsRepository: VcsRepository
  tags: [TagRecord]
  approvedEnvironments: [String]
  approvalEvents: [ReleaseApprovalEvent]
  approvalRequests: [ReleaseApprovalRequest]
  variantDetails: [Variant]
  updateEvents: [ReleaseUpdateEvent]
  metrics: DependencyTrackMetrics
  identifiers: [Identifier]
  """
  Pointer to the document bytes this release publishes. Non-null only on releases of
  specification components -- an ordinary software release has no document.
  """
  document: DocumentRef
  gudidRecord: GudidRecord
  gudidStatus: GudidStatus
  """
  Release lifecycle date: the CLE END_OF_SUPPORT projection (TeaTransformerService).
  NOT the device support window -- that is declared on the device model at
  ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
  """
  eos: String
  """
  Release lifecycle date: the CLE END_OF_LIFE projection (TeaTransformerService).
  NOT the device support window -- that is declared on the device model at
  ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
  """
  eol: String
  """
  Per-release override of the org-level FDA assessment narrative.
  
NULL MEANS INHERIT, not empty. Read it through the resolution seam -- release
  value else the org's Settings.fdaAssessmentNarrative -- never on its own: a
  generator reading only this field renders a blank justification section for
  every release that never set one, which is the overwhelming majority.
  """
  fdaAssessmentNarrative: String
  """
  Provenance for the release's own eos/eol -- the CLE lifecycle projections, NOT
  the device support window -- DERIVED from the most recent SUPPORT_WINDOW update
  event rather than stored separately. Null on a
  release whose window has never been touched (including one set only at
  release creation before this field existed).
  """
  supportWindowSource: ProgrammaticType
  supportWindowAssertedBy: ID
  supportWindowLastAssessed: DateTime
  """
  Component name snapshot captured when a sid PURL was first emitted for this release (D6).
  Immutable once set. Null on releases pre-dating sid enablement and on releases of
  EXTERNAL components.
  """
  sidComponentName: String
  """
  Resolved BOM root identifier per the D4 picker: sid PURL > any other PURL >
  release UUID. Always non-null. Used by the UI to display the canonical
  identifier and matches what VDR / OBOM / aggregated-SBOM emit at the BOM root.
  """
  preferredBomIdentifier: String
  releaseCollection: ReleaseCollection
  """
  Adjacent releases on this release's own branch / feature set, ordered by
  created date (the same CANCELLED-excluding lineage used for the SBOM-component
  changelog). previousRelease is the release created immediately before this one
  on the branch, nextRelease the one immediately after; both are null at the
  branch's first / last release. Unlike the changelog baseline these do NOT fall
  back to a base-branch fork point -- navigation stays within the same branch.
  Lazily resolved: only queried when selected. Select a light subselection
  (e.g. uuid version lifecycle createdDate) -- used by the release view's
  prev/next navigation arrows.
  """
  previousRelease: Release
  nextRelease: Release
  intermediateFailedReleases: [IntermediateFailedRelease]
  sbomReconcilePending: Boolean
  """
  Distinct AgentSessions whose commits contributed to this release.
  Walks release.commits -> SCE.agentSession (the forward pointer set
  by the PR 2 commit-trailer parser) and dedupes. Empty list when
  no commits carry agent attribution.
  """
  sessions: [Session]
}

type SbomProbingResult {
  status: SbomProbingStatus!
  metrics: DependencyTrackMetrics
}

input GetLatestReleaseInput {
  """
  Component / product uuid, or -- with an organization-scoped key -- its name:
  matched case-insensitively against the org's active components and products,
  exactly one hit required (unknown or ambiguous names error).
  """
  component: ID
  product: ID
  branch: String
  tags: [TagRecordInput]
  lifecycle: ReleaseLifecycleEnum
  conditions: ConditionGroupOnGetLatestReleaseInput
  vcsUri: String
  repoPath: String
  upToVersion: String
  """
  Only consider releases whose approvedEnvironments contains this built-in
  environment (DEV, BUILD, TEST, SIT, UAT, PAT, STAGING, PRODUCTION; case-insensitive).
  Orthogonal to lifecycle and conditions: they are applied on top when set.
  Environment approvals are granted by an ADD_APPROVED_ENVIRONMENT trigger or an
  admin override; a later policy disapproval does not revoke them (only an admin
  override removes), so combine with approval-entry conditions when the current
  approval state matters. Like conditions, this scans the newest 300 releases
  of the branch.
  """
  approvedEnvironment: String
}

enum InstanceStateType {
  PLAN
  ACTUAL
}

type PropSecrets {
  properties: [KeyValue]
  secrets: [KeyValue]
}

type ComponentAuthentication {
  login: String
  password: String
  type: String
}

type InstanceProductFeatureSets {
  namespace: String
  product: NamedRef!
  currentFeatureSet: NamedRef
  """
  Integrate type of the plan entry: FOLLOW (latest release approved for the instance environment),
  TARGET (pinned release), INTEGRATE, NONE or UNINSTALL.
  """
  integrateType: IntegrateType
  """
  Release the plan currently aims at: the FOLLOW-resolved release or the pinned TARGET release.
  Null when nothing is selected yet (TARGET without a release, or no approved release).
  """
  targetRelease: FeatureSetReleaseRef
  """
  Release the instance actually reports as running for this product (matched from agent data).
  Null when nothing has matched yet.
  """
  deployedRelease: FeatureSetReleaseRef
  availableFeatureSets: [FeatureSetOption!]!
}

"""
One actionable event the agent owning a session needs to react to --
typically a release minted from the session's commits changing
lifecycle (REJECTED by a CEL gate, ASSEMBLED, etc.) or carrying a
new approval (DISAPPROVED with reviewer comment is the canonical
"agent fix loop" trigger). Polled by the agent via
{@code agentSessionInboxProgrammatic} with a cursor it stores
client-side.
"""
type AgentSessionInboxEvent {
  """
  Opaque, monotone cursor token. Pass back as the {@code since}
  field on the next poll to fetch strictly newer events. Stable --
  the same event always returns the same cursor.
  """
  cursor: String!
  occurredAt: DateTime!
  kind: AgentInboxEventKind!
  """
  Release this event is about, when {@code kind} is release-side
  (LIFECYCLE_CHANGE / APPROVAL). Null on session-side events
  (POLICY_VERDICT).
  """
  release: Release
  """
  Previous value, when meaningful (e.g. prior lifecycle).
  """
  oldValue: String
  """
  New value (e.g. new lifecycle, "DISAPPROVED").
  """
  newValue: String
  """
  Free-form human-readable reason for the event:
    - LIFECYCLE_CHANGE: the matching ReleaseUpdateEvent.message
      (e.g. "Triggered by 'Reject when any commit is not VERIFIED'
      (CEL: …)") -- what *caused* the lifecycle change.
    - APPROVAL: the reviewer's free-text comment when
      DISAPPROVED; null on APPROVED unless a comment was left.
    - POLICY_VERDICT: the failing policy's failure message.
  """
  reason: String
  source: AgentInboxSource!
  """
  User uuid that authored the change, when {@code source = HUMAN}.
  Null for automated / policy-driven events.
  """
  actorUuid: ID
  """
  Approval role id ({@code ApprovalEntry.roleId} snapshot), when {@code kind = APPROVAL}.
  """
  actorRoleId: String
}

input AgentSessionInboxInput {
  sessionUuid: ID!
  """
  Opaque cursor from a prior poll. Null = "from session start".
  Server returns events strictly after this cursor.
  """
  since: String
  """
  Optional filter; null = all kinds.
  """
  kinds: [AgentInboxEventKind!]
  """
  Default 50; capped at 200.
  """
  limit: Int
}

"""
One ROOT Agent invocation. Many concurrent sessions per agent are
allowed on the same API key. Sub-agents of the root contribute
commits / artifacts to the same session via the commit-trailer
attribution path (PR 2).
"""
type Session {
  uuid: ID
  org: ID
  """
  Owning ROOT agent uuid.
  """
  agent: ID
  """
  Agent-supplied natural session id. Defaults to the row uuid when
  the agent didn't pick one on initialize. The two-line commit
  trailer references this value, not the row uuid.
  """
  clientSessionId: String
  """
  API key the agent used to open the session.
  """
  apiKey: ID
  title: String
  status: SessionStatus
  startedAt: DateTime
  closedAt: DateTime
  lastActivityAt: DateTime
  """
  Rollup of this session's usage rows; null until the first report arrives.
  """
  usageTotals: UsageTotals
  usageCompleteness: SessionUsageCompleteness
  """
  Observed usage resolved to a different model than the session declared.
  """
  modelMismatch: Boolean
  """
  Artifact UUIDs attached to this session (reuses rearm.artifacts).
  """
  artifacts: [ID]
  """
  SCE UUIDs attributed to this session via the commit-trailer parser
  (PR 2). Order is append-order; head of list is the earliest commit.
  """
  commits: [ID]
  """
  Append-only log of agent-policy evaluations (PR 4). Empty on CE
  deployments and on sessions opened under an org with no policies.
  """
  policyEvents: [PolicyEvent]
  """
  Releases produced from this session's commits. Computed at read
  time by walking `commits → Release.sourceCodeEntry` (and
  `commits[]` for multi-commit releases). Distinct on release uuid.
  """
  releases: [Release]
  """
  Pull requests touched by this session's commits. Computed at read
  time by walking `commits → PullRequest.commits[]`. Distinct on
  PR uuid.
  """
  pullRequests: [PullRequest]
  """
  If this session was opened by an agent retrying after a prior
  BLOCKED / CLOSED predecessor, this is that predecessor's uuid.
  Null on first-time sessions.
  """
  parentSession: ID
  """
  The AI model this session ran. The model is a property of the chat,
  not the durable agent -- set from the agent's declared model on
  initialize. Null on legacy sessions written before per-session model
  tracking existed. Prefer this over the deprecated Agent.model.
  """
  primaryModel: ModelOntology
  """
  How much trust primaryModel carries. DECLARED = the agent self-
  reported the model string (the only source today). RUNTIME_OBSERVED is
  reserved for host-side hooks that read the model from the runtime's own
  record; not yet emitted. The UI must not imply the model carries the
  session signature's authority.
  """
  modelAssertion: ModelAssertionState!
  """
  The agent tool's own sessions this ReARM session ran in -- what joins it back to the
  conversation and transcript that produced its work. Empty when the client reported none.
  Not unique either way: one tool session often opens many ReARM sessions, and a ReARM
  session resumed in a new conversation records both.
  """
  providerSessions: [ProviderSession!]
  """
  How the session came to be opened: the credential, the person behind it when anything names
  one, and the device. Captured once at initialize; null on sessions opened before it was
  recorded. Hostnames, IP addresses and a federated actor are withheld unless the reader is an
  org admin, the session's owner, or the key that opened it -- see SessionOrigin.restricted.
  """
  origin: SessionOrigin
  createdDate: DateTime
}

type AgentBoard {
  uuid: ID
  org: ID
  name: String
  description: String
  status: AgentBoardStatus
  """
  Wired tracker repos, e.g. github:owner/repo. Registration validates task refs against them.
  """
  sources: [String]
  """
  Where this board's documents are written, as the repository row it resolves
  to. Set by passing a URI to agentBoardUpdate; the row is the identity, so a
  remote written as ssh on one machine and https on another is the same
  repository here.
  """
  documentsRepo: VcsRepository
  """
  Per-type path templates inside documentsRepo, as overridden on this board; omitted types use the defaults by scope (effectiveDocumentPaths).
  """
  documentPaths: Object
  """
  The repository path a new document of this type would take, with every placeholder filled:
  {task} = first eight characters of the task uuid, {round} = the task's next round of this type,
  {type} = lower case, {component} = the component's name slugged. task is required for
  task-scoped types, component for component-scoped ones. The release records the path actually
  used; this is what the CLI uses when no --file is given.
  """
  documentPath(
  specification: SpecificationType!
  task: ID
  component: ID): String
  """
  Every type's template after overrides and scope defaults: the built-in index types per task,
  a type some active role produces at TASK scope under docs/{type}/{task}/round-{round}.md, any
  other under docs/{type}/{component}.md.
  """
  effectiveDocumentPaths: Object
  """
  Append-only board notices, newest last (lock transitions auto-append; coordinator posts ALERT/INFO). Replaces the coordinating-issue concept.
  """
  events: [AgentBoardEvent]
  """
  Delivery-minimum alert: capabilities covered neither by an active role nor by the coordinator (coordinatorCapabilities). The minimum is CODE_PUSH + PR_MERGE; the tracker verbs are always the coordinator's.
  """
  missingCapabilities: [String]
  """
  Served prompt of the implicit, non-removable coordinator role.
  """
  coordinatorPrompt: String
  """
  Verbs the coordinator seat performs itself on this board, e.g. PR_MERGE when it merges once
  the last required role has passed. Unverified, like a role's capabilities; the delivery-loop
  alert (missingCapabilities) counts them as covered.
  """
  coordinatorCapabilities: [AgentCapability]
  lock: AgentBoardLock
  coordinatorSeat: AgentCoordinatorSeat
  """
  Max concurrently ASSIGNED tasks per agent on this board (default 2).
  """
  perAgentWipLimit: Int
  """
  What every task on this board may spend together, in USD micros; null means no board limit.
  """
  budgetMicros: Long
  """
  Percent of a budget at which the board posts one alert and nothing stops (default 80).
  """
  softAlertPercent: Int
  """
  Rounds between one pair of roles before a task parks (default 3).
  """
  cycleCap: Int
  """
  Repeated rounds at which a task parks; 1, the default, parks on the first repeat.
  """
  noProgressRepeatsToStop: Int
  """
  Priority number at or below which an open item blocks routing, 1 being most urgent. Null is strict.
  """
  blockingPriority: Int
  """
  Priority number at or below which an open item prevents a policy completion. Null is strict.
  """
  completionPriority: Int
  """
  Whether coordinator priority is advisory (LAX, default) or enforced at assignment (STRICT).
  """
  priorityType: AgentBoardPriorityType
  """
  The component this board builds -- the node documents and implementation hang off.
  """
  target: ID
  targetDetails: Component
  """
  Level applied to tasks of this board that do not declare one.
  """
  defaultTaskLevel: Int
  """
  Resolution mode for requirements of this board that do not name one.
  """
  defaultInputResolution: AgentInputResolution
  createdDate: DateTime
  """
  The board file that last applied to this board; null on a board never applied from a file.
  """
  declarative: DeclarativeProvenance
}

"""
Everything an agent needs to see what else is happening on its board, in one read.

An agent that must ask N questions to understand the board will not ask them; one that gets the
answer in a poll's worth of latency will. Read-only and board-scoped, and nothing appears before
it is published -- a hop has no outputs until it signs off.
"""
type AgentBoardSnapshot {
  board: AgentBoard
  tasks: [AgentTaskSnapshot]
}

"""
What a polling/assigned worker receives: the task, the role to assume and its served prompt.
"""
type AgentTaskAssignment {
  task: AgentTask
  role: String
  """
  The role config row `role` names, so a worker can read that role's configuration without a lookup by name.
  """
  roleUuid: ID
  rolePrompt: String
  promptVersion: String
  """
  Versions the agent is to work from, resolved at assignment.
  """
  resolvedInputs: [AgentResolvedInput]
  """
  What this hop is expected to cost, in USD micros: the role's allowance. Not a cap -- a hop that
  will blow it should be returned (reason OTHER, saying so) rather than pressed on. Null when the
  role sets none.
  """
  hopBudgetMicros: Long
}

type AgentTask {
  uuid: ID
  org: ID
  board: ID
  """
  What this task may spend, in USD micros; null means only the board's limit applies.
  """
  budgetMicros: Long
  """
  Coordinator spend apportioned to this task, frozen when computed. An estimate, not a measurement.
  """
  coordinatorEstimateMicros: Long
  """
  When the task was last reopened; null when never.
  """
  reopenedAt: DateTime
  """
  How many times the task has been reopened. A second reopen is a signal to split or cancel.
  """
  reopenCount: Int
  """
  Every reopen, oldest first: the role it went back to, when, by whom and why.
  """
  reopens: [AgentTaskReopen]
  """
  Model strength this task requires, overriding the role's when set.
  """
  requiredStrength: Float
  """
  Who set requiredStrength, and when. Not a status transition: the status did not change.
  """
  strengthSetBy: AgentActor
  strengthSetAt: DateTime
  """
  Rounds counted per pair of roles, keyed by the asking and answering role uuids.
  """
  cycles: Object
  """
  Who is waiting on whom, innermost last. Empty when nothing is outstanding.
  """
  questionStack: [AgentQuestionFrame]
  externalRef: String
  title: String
  sourceUrl: String
  status: AgentTaskStatus
  """
  Role the task is queued for / worked in; retained as last role until re-authorized.
  """
  role: String
  """
  The role config row `role` names, so a reader reaches its prompt, capabilities and gate without a second lookup. Null on tasks authorized before this field existed.
  """
  roleUuid: ID
  """
  Coordinator-set priority; polls serve lowest first among ELIGIBLE tasks.
  """
  orderIndex: Int
  """
  Who last set orderIndex, the coordinator or a person, and when.
  """
  orderSetBy: AgentActor
  orderSetAt: DateTime
  """
  Required roles a person completed the task without, having said why in the completing status change.
  """
  requiredRolesSkipped: [String]
  """
  Tasks that must be COMPLETED before this one is assignable (coordinator-declared, gate-enforced).
  """
  dependsOn: [ID]
  """
  Hold state while ON_HOLD; null otherwise.
  """
  hold: AgentTaskHold
  """
  Per-task add-only human gate: the next sign-off, whatever the role, parks the task for human review.
  """
  requireHumanReview: Boolean
  assignment: AgentTaskWorkAssignment
  signOffs: [AgentTaskSignOff]
  returns: [AgentTaskReturn]
  parentTask: ID
  childTasks: [ID]
  """
  Every session that ever held the assignment.
  """
  sessions: [ID]
  prUrls: [String]
  registeredBySession: ID
  """
  Append-only status transition log, oldest first.
  """
  statusHistory: [AgentTaskStatusChange]
  createdDate: DateTime
  completedAt: DateTime
  """
  The component this task produces -- a document component, or the implementation.
  """
  producesComponent: ID
  producesComponentDetails: Component
  """
  Releases produced under this task, linked by the worker.
  """
  releases: [ID]
  """
  Declared level of the work; falls back to the board's defaultTaskLevel at registration.
  """
  level: Int
  """
  Requirements this task adds on top of its role's -- add-only.
  """
  requiredInputs: [AgentRequiredInput]
  """
  Pinned inputs that have since moved below what the requirement asks for; computed per read.
  """
  regressedInputs: [String]
  """
  Everything attributed to this task, across every hop and session that
  touched it. Computed per read rather than stored, so late attribution is
  reflected without a rewrite. Null until the first report lands. Built from
  the hop snapshots, which are frozen when a hop ends: a hop reported after it
  closed reads lower here than in the budget, which reads the usage rows
  (spentMicros on the board snapshot), until the snapshot is refreshed.
  """
  usage: HopUsage
  """
  This task's document releases, newest first.
  """
  documents: [Release]
  """
  Findings still open on this task, from the NEWEST round of each indexed
  type, ordered by priority. Newest round only by design: every round
  carries forward what the previous one left open, so the newest is the
  current state and summing rounds would count one finding several times.
  """
  openFindings: [Finding]
  """
  The open items of the newest QUESTIONS round only, which is what a human answers. Separate
  from openFindings, which flattens every indexed type and carries nothing on an item saying
  which round it came from.
  """
  openQuestions: [Finding]
}

enum AgentTaskStatus {
  PENDING_INTAKE
  QUEUED
  ASSIGNED
  AWAITING_COORDINATOR
  ON_HOLD
  COMPLETED
  CANCELLED
}

"""
Board-scoped role definition. The coordinator is implicit and never a row here.
"""
type AgentTaskRoleConfig {
  """
  Allowance for one assignment of this role, in USD micros: the projection's estimate when the board has no history for the role, told to the worker at assignment, and flagged on the hop and the board when a hop exceeds it. Not enforced mid-hop -- agents pull, and the server learns the cost when it is reported. Null sets no allowance.
  """
  hopBudgetMicros: Long
  """
  Model strength this role needs; null admits every model. At most two decimal places;
  within 0.001 either side counts as meeting it.
  """
  requiredStrength: Float
  """
  How far above requiredStrength a model may be and still take the role. 0 means an exact match.
  """
  strengthHeadroom: Float
  """
  Which of a model's per-category strengths this role reads, so a board role with its own name
  (PLANNER) can use a model's ARCHITECT strength. Null reads the model's base strength.
  """
  strengthCategory: ModelRoleCategory
  """
  Per-model strength overrides for this role, consulted first: override, then the model's
  strength for strengthCategory, then its base strength. Re-pointed when a model is merged.
  """
  modelStrengths: [RoleModelStrength!]
  uuid: ID
  board: ID
  org: ID
  name: String
  prompt: String
  """
  Advisory routing order for the coordinator; routing is a per-hop decision, not a pipeline.
  """
  orderIndex: Int
  """
  Optional cap on concurrently ASSIGNED tasks in this role on this board.
  """
  wipLimit: Int
  """
  Assigned agent must differ from the last sign-off's agent (separation of duties).
  """
  requireDistinctAgent: Boolean
  active: Boolean
  """
  Capabilities an assignee of this role must hold (declared, unverified in v1).
  """
  requiredCapabilities: [AgentCapability]
  """
  Operator-only: who works this role (default AGENTIC).
  """
  kind: AgentRoleKind
  """
  Operator-only: may the coordinator skip this role (default OPTIONAL).
  """
  necessity: AgentRoleNecessity
  """
  Operator-only: conditional human review of this role's sign-offs (default NONE; AGENTIC roles only).
  """
  humanGate: AgentHumanGate
  """
  What every task in this role must be able to read before it starts.
  """
  requiredInputs: [AgentRequiredInput]
  """
  What a hop in this role must leave behind: the mirror of requiredInputs.
  Enforced at sign-off, not at assignment -- the hop has to run before it
  can produce anything.
  """
  producesOutputs: [AgentProducedOutput]
}

type DeclarativeApplyResult {
  kind: DeclarativeKind!
  dryRun: Boolean!
  specHash: String!
  changes: [DeclarativeChange!]!
  created: Int!
  updated: Int!
  unchanged: Int!
  archived: Int!
  errors: Int!
}

"""
Catalog slice: components and products of an organization (no branches, no releases).
"""
input CatalogSpecInput {
  """
  Must be CATALOG; the file's kind is validated against the operation.
  """
  kind: DeclarativeKind!
  version: Int!
  """
  When true the file claims every active component / product of the org: with
  Settings.declarativePrune = ARCHIVE, components not listed are archived. Partial
  files (per team) leave this false.
  """
  authoritative: Boolean
  components: [CatalogComponentInput!]!
}

"""
Where an applied spec came from, recorded on every row the apply touched.
"""
input DeclarativeSourceInput {
  repo: String
  path: String
  commit: String
}

"""
Branches slice: branches of a component, or feature sets of a product. The file is authoritative for that component.
"""
input BranchesSpecInput {
  """
  Must be BRANCHES; the file's kind is validated against the operation.
  """
  kind: DeclarativeKind!
  version: Int!
  """
  Component or product name.
  """
  component: String!
  """
  When true (the default for files) the spec claims every non-base branch of the component and
  Settings.declarativePrune decides what happens to branches it does not list. Single-branch
  callers such as the Terraform provider pass false.
  """
  authoritative: Boolean
  branches: [BranchSpecInput!]!
}

"""
A board file (kind BOARD). Keyed by name within the organization. A field left out is untouched;
a field set to null is cleared where that means something: description, each setting, a role's
wipLimit, hopBudgetMicros and each part of its strength. A role the file does not list is
deactivated, never deleted.
"""
input BoardSpecInput {
  kind: DeclarativeKind!
  version: Int!
  name: String!
  description: String
  """
  Component name in this organization; required when the file creates the board.
  """
  target: String
  defaultTaskLevel: Int
  defaultInputResolution: AgentInputResolution
  priorityType: AgentBoardPriorityType
  perAgentWipLimit: Int
  sources: [String!]
  documentsRepo: String
  documentPaths: Object
  coordinatorPrompt: String
  """
  Verbs the coordinator seat performs itself: PR_MERGE, CODE_PUSH. The tracker verbs are
  implicit and refused. Declared null clears, as [] does; absent leaves them.
  """
  coordinatorCapabilities: [AgentCapability!]
  settings: BoardSettingsSpecInput
  roles: [BoardRoleSpecInput!]
}

"""
A presets file (kind ROLE_PRESETS). authoritative deactivates presets the file does not list.
"""
input RolePresetsSpecInput {
  kind: DeclarativeKind!
  version: Int!
  authoritative: Boolean
  presets: [BoardRoleSpecInput!]
}

"""
First-class PullRequest entity. Owns its own identity at the SCM level
(target VCS + identity string), its own commit list (SCE UUIDs), and
both inbound (release_validation_events) and outbound
(pr_validation_events) event streams.
"""
type PullRequest {
  uuid: ID
  org: ID
  targetVcsRepository: ID
  sourceVcsRepository: ID
  identity: String
  state: String
  title: String
  sourceBranchName: String
  targetBranchName: String
  endpoint: String
  commits: [ID]
  prCreatedDate: DateTime
  closedDate: DateTime
  mergedDate: DateTime
  createdDate: DateTime
  prValidationEvents: [PullRequestValidationEvent]
  releaseValidationEvents: [ReleaseValidationEvent]
  """
  Releases currently attributed to this PR -- every release whose
  primary sourceCodeEntry is one of the PR's commits, scoped to
  the PR's org. Same logic the aggregator uses to compute the
  PR-level verdict (no dispatch is triggered). Empty when the PR
  has no commits or no releases have been minted against any of
  them yet.
  """
  attributedReleases: [Release]
  """
  Hydrated commit list -- SCE rows for every entry in `commits`.
  Order matches `commits` (head is the last element). Used by the
  UI to render the actual git commit SHA / message / author
  instead of just the SCE UUID. Missing SCEs (e.g. one that was
  since archived) are silently dropped.
  """
  commitDetails: [SourceCodeEntry]
  """
  Releases referenced by any release_validation_event in this PR's
  history -- superset of attributedReleases. Required so the UI can
  display release names for events whose release has since been
  superseded (newest-per-component attribution drops the older
  release from attributedReleases but its event row remains).
  Distinct on UUID; missing releases (archived) are silently dropped.
  """
  validatedReleaseDetails: [Release]
  """
  Latest pr_validation_event verdict whose sourceCodeEntry matches
  the PR's current head commit. Mirrors the aggregator's
  "latest-for-head" lookup so this resolver and the SCM dispatch
  read the same value. {@code null} when the PR has no commits, no
  validation events, or no event for the current head -- UI should
  render that as "pending / not yet validated".
  """
  currentValidationState: ValidationState
  """
  Distinct ROOT agents that contributed to this PR -- walks
  `commits → SCE.agent → resolveRoot`. One PR can be attributed to
  multiple agents (different commits from different sessions / keys).
  Empty when no commits carry agentic attribution. Order is by first
  appearance in `commits`.
  """
  agents: [Agent]
}

input PullRequestUpsertProgrammaticInput {
  identity: String!
  state: String!
  title: String
  sourceBranchName: String
  targetBranchName: String
  endpoint: String
  """
  Target VCS resolution. With a COMPONENT API key the component is
  implicit (the key identifies it) -- `component` / `vcsUri` are not
  needed. With an ORGANIZATION_RW or FREEFORM key, supply either
  `component` (UUID of the target component, whose VCS is used) or
  the (`vcsUri`, `repoPath`) pair plus optionally `vcsDisplayName`.
  When both are present, `component` wins and vcsUri/repoPath are
  ignored.
  """
  component: ID
  vcsUri: String
  repoPath: String
  vcsDisplayName: String
  """
  When supplied, the backend looks up the SCE for (targetVcs, commit)
  and advances the PR head to it if found. If no SCE exists yet for
  that commit, the PR row is registered without a head -- the
  subsequent addReleaseProgrammatic call carrying the same PR input
  will advance the head once the SCE is persisted.
  """
  commit: String
}

type Version {
  version: String
  dockerTagSafeVersion: String
  changelog: String
  releaseAlreadyExists: Boolean
  """
  Lifecycle of the resolved release at the time getNewVersion returned.
  Reflects the state AFTER any synchronous component-trigger run during
  release creation -- so a CEL gate that pre-emptively moves the release
  to REJECTED is visible here. Callers (CLI / CI actions) should abort
  downstream build steps when this is a terminal state (REJECTED,
  CANCELLED) instead of charging into a subsequent addrelease that will
  collide on the (component, version) dedup gate. Null on the
  onlyVersion path (no release row was created).
  """
  lifecycle: ReleaseLifecycleEnum
}

input GetNewVersionInput {
  component: ID
  branch: String!
  modifier: String
  action: String
  metadata: String
  versionSchema: String
  lifecycle: ReleaseLifecycleEnum
  onlyVersion: Boolean
  sourceCodeEntry: SourceCodeEntryInput
  commits: [SourceCodeEntryInput]
  vcsUri: String
  repoPath: String
  vcsDisplayName: String
  createComponentIfMissing: Boolean
  createComponentName: String
  createComponentVersionSchema: String
  createComponentFeatureBranchVersionSchema: String
  """
  Optional perspective UUID. When supplied with createComponentIfMissing
  and the component does not yet exist, the new component is created and
  assigned to this perspective; authorization with a FREEFORM key requires
  WRITE on the perspective. Ignored when the component already exists.
  """
  perspective: ID
  """
  Optional PR metadata bundled with the call. When supplied on
  addReleaseProgrammatic, a first-class PullRequest entity is upserted
  by (targetVcsRepository, identity) and its head is advanced to the
  release's SCE. The PR aggregator picks up the release on subsequent
  VALIDATE_PR firings. Ignored on calls that do not create a release.
  """
  pullRequest: PullRequestInfoInput
  """
  Opt-in dedup override for the commit-keyed gate on
  (component, branch, commit). When a version_assignment already
  exists for the supplied commit on this branch:
    - rebuild = false (default) → mutation fails with an error so the
      duplicate CI run can fail fast instead of minting a second
      release on the same head.
    - rebuild = true → return the existing version assignment so the
      caller intentionally reuses the same version (e.g. a re-issue
      of an artifact for the same commit).
  No effect when no commit is supplied (manual mints, marketing
  versions, commit-less callers).
  """
  rebuild: Boolean
}

"""
An accountable statement by a user or an agent. Append-only: a correction is a new row plus a
revocation of the old one, because a record that can be edited afterwards is not one.
"""
type Attestation {
  uuid: ID
  org: ID
  type: AttestationType
  subjectType: AttestationSubjectType
  subjectUuid: ID
  subjectRef: AttestationSubjectRef
  actorType: AttestationActorType
  actorUuid: ID
  """
  AGENT: the session it was filed under.
  """
  agentSession: ID
  verdict: AttestationVerdict
  note: String
  """
  LOCK_RELEASE: released without the requirement being met. Never silent.
  """
  override: Boolean
  status: AttestationRecordStatus
  revokedAt: DateTime
  revokeReason: String
  createdDate: DateTime
}

"""
How a programmatic caller names a component: by uuid, or by the VCS coordinates CI already has.
The same block getversion and addrelease accept, resolved by the same code, so a CI job that can
call one can call the others without learning a second convention.
"""
input ComponentRefInput {
  component: ID
  vcsUri: String
  repoPath: String
}

"""
Verdicts of a commit acknowledgement. MINE makes a commit recognized; it does not certify the
content and is not a review. NOT_MINE leaves it unrecognized and escalates every lock it is a
cause of.
"""
enum AttestationVerdict {
  MINE
  NOT_MINE
}

"""
A sticky refusal of writes on a component or one of its branches.

Every other gate in ReARM evaluates a point in time, so a rule about a commit is defeated by
pushing another commit on top of it. A lock is the state that outlives the build: it refuses the
next one outright and stays until somebody resolves the cause and says so on the record.
"""
type Lock {
  uuid: ID
  scope: LockScope
  """
  Set when scope is BRANCH.
  """
  branch: ID
  status: LockStatus
  """
  Shown verbatim in every refusal.
  """
  reason: String
  origin: LockOrigin
  """
  POLICY: the output event that raised it, which is also its idempotence key.
  """
  outputEvent: ID
  causes: [LockCause!]
  """
  Causes dropped by the retention cap. Above zero the checklist is incomplete, so the lock will
  not release itself automatically however many causes are claimed.
  """
  droppedCauses: Int
  unlockLevel: UnlockLevel
  attestationRequirement: AttestationRequirement
  """
  The strongest level any cause has ever implied, kept because that cause may since have been
  dropped. A floor, never lowered.
  """
  escalatedLevel: UnlockLevel
  """
  Declared level and escalation floor combined -- who may actually release it.
  """
  effectiveLevel: UnlockLevel
  raisedAt: DateTime
  releasedAt: DateTime
  """
  The LOCK_RELEASE attestation that released it.
  """
  releaseAttestation: ID
  """
  Where the lock lives. A lock is stored inside its component or branch row, so these come from
  the read rather than from the record -- without them an organization-wide list of locks could
  not say what any of them was about.
  """
  component: ID
  componentName: String
  branchName: String
}

input ReleaseInputProg {
  version: String!
  lifecycle: ReleaseLifecycleEnum
  component: ID
  branch: String
  sourceCodeEntry: SourceCodeEntryInput
  artifacts: [ArtifactInput]
  inboundDeliverables: [DeliverableInput]
  outboundDeliverables: [DeliverableInput]
  endpoint: String
  commits: [SourceCodeEntryInput]
  """
  DEPRECATED -- silently dropped by addReleaseProgrammatic. The resolver
  only consumes source-code-entry artifacts from `sourceCodeEntry.artifacts`
  (or each `commits[i].artifacts` for multi-commit inputs). Nest the
  artifacts there instead. The server logs a WARN whenever this field
  is supplied so we can track remaining callers before removing it.
  """
  sceArts: [ArtifactInput] @deprecated(reason: "Nest SCE artifacts under sourceCodeEntry.artifacts (or commits[i].artifacts); this top-level field is ignored by addReleaseProgrammatic.")
  identifiers: [IdentifierInput]
  gudidRecord: GudidRecordInput
  gudidStatus: GudidStatus
  """
  Release lifecycle date: the CLE END_OF_SUPPORT projection (TeaTransformerService).
  NOT the device support window -- that is declared on the device model at
  ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
  """
  eos: String
  """
  Release lifecycle date: the CLE END_OF_LIFE projection (TeaTransformerService).
  NOT the device support window -- that is declared on the device model at
  ComponentData.medicalProfile.deviceSupportWindow and resolved by DeviceLifecycleResolver.
  """
  eol: String
  vcsUri: String
  repoPath: String
  vcsDisplayName: String
  createComponentIfMissing: Boolean
  createComponentName: String
  createComponentVersionSchema: String
  createComponentFeatureBranchVersionSchema: String
  """
  Optional perspective UUID. When supplied together with createComponentIfMissing=true and
  the component does not yet exist, the new component is created and assigned to this
  perspective. Required scope on the API key is WRITE on the perspective (FREEFORM keys)
  or any broader scope that covers it. Ignored when the component already exists.
  """
  perspective: ID
  rebuildRelease: Boolean
  """
  Optional PR metadata bundled with the call. When supplied on
  addReleaseProgrammatic, a first-class PullRequest entity is upserted
  by (targetVcsRepository, identity) and its head is advanced to the
  release's SCE. The PR aggregator picks up the release on subsequent
  VALIDATE_PR firings. Ignored on calls that do not create a release.
  """
  pullRequest: PullRequestInfoInput
}

input AddODeliverableInput {
  release: ID
  component: ID
  variant: ID
  version: String
  deliverables: [DeliverableInput]
}

type Component {
  uuid: ID
  name: String
  org: ID
  resourceGroup: ID
  type: ComponentType
  kind: ComponentKind
  versionSchema: String
  marketingVersionSchema: String
  versionType: VersionType
  vcs: ID
  vcsRepositoryDetails: VcsRepository
  featureBranchVersioning: String
  repositoryEnabled: Int
  status: Status
  apiKeyId: String
  apiKey: String
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  defaultConfig: String
  visibilitySetting: VisibilitySetting
  approvalPolicy: ID
  approvalPolicyDetails: ApprovalPolicy
  """
  Resolved approval policy for this component. Per-component
  {@code approvalPolicy} wins when present AND still references an
  existing policy. Otherwise the org-wide rule list is walked in
  order; the first rule whose {@code namePattern} matches the
  component's name AND whose {@code componentType} accepts the
  component's type contributes its policy. {@code source} discriminates
  between the cases; {@code ruleName} is set only when source =
  ORG_RULE; {@code alsoMatchedRuleNames} carries any later-list rules
  whose pattern + type-filter also matched; {@code perComponentPolicyArchived}
  is true when the component carried a per-component reference but
  the referenced policy was archived/missing, so resolution fell
  through to org rules (signals a stale reference for the UI to
  warn about).
  """
  effectiveApprovalPolicy: EffectiveApprovalPolicy
  releaseInputTriggers: [ReleaseInputEvent]
  outputTriggers: [ReleaseOutputEvent]
  identifiers: [Identifier]
  nature: ComponentNature
  deviceClass: DeviceClass
  medicalProfile: MedicalProfile
  repoPath: String
  authentication: ComponentAuthentication
  branchSuffixMode: BranchSuffixMode
  globalInputEventRefs: [GlobalInputEventRef]
  perspectiveDetails: [Perspective]
  """
  Component-level sid override (null = INHERIT).
  """
  sidPurlOverride: SidPurlOverride
  """
  Component-level decoded authority segments (null/empty = none stored).
  """
  sidAuthoritySegments: [String!]
  """
  Internal/external classification (D16). Null on legacy rows is treated as INTERNAL.
  """
  isInternal: BelongsToOrganization
  """
  Synthetic component-level lifecycle derived from the lifecycles of the
  component's releases:
  - if every release lifecycle is ≤ GENERAL_AVAILABILITY, returns the
    most-advanced of those (i.e. max-pre-or-at-GA);
  - otherwise returns the smallest lifecycle ≥ GENERAL_AVAILABILITY
    observed across releases (i.e. min-post-GA).
  Null when the component has no releases.
  """
  effectiveLifecycle: ReleaseLifecycleEnum
  """
  Manually-assigned lead user UUIDs for this component/product.
  """
  leads: [ID!]
  """
  Resolved org-user details for the manually-assigned leads.
  """
  leadDetails: [OrgUserData!]
  """
  Freeform stakeholder contacts for non-registered users (HTML-sanitized on write).
  """
  contacts: [ComponentContact!]
  """
  Derived team: org users holding a READ_WRITE-or-stronger COMPONENT-scoped
  permission on this component. Falls back up the parent (product) chain when
  the component itself has no direct members.
  """
  team: [OrgUserData!]
  """
  Derived approvers: org users whose COMPONENT-scoped permission on this
  component carries one or more approval-role grants. Same parent fallback as team.
  """
  approvers: [OrgUserData!]
  """
  Stored durable owner (team-preferred, USER escape hatch); null = none set (RFC Phase 4).
  """
  owner: ComponentOwner
  """
  Computed ownership resolution: status / durability / derived suggestion. Pure
  recompute (never stored); a non-OWNED status drives a non-blocking banner + the
  at-risk report and NEVER blocks releases.
  """
  ownership: ComponentOwnership!
  """
  Guards written on this component. They accumulate with the guards its perspectives and its
  organization declare for it -- every applicable guard is evaluated and any one can refuse.
  """
  actionGuards: [ActionGuard!]
  """
  Locks raised on this component, active and recently released.
  """
  locks: [Lock!]
}

input CreateComponentInput {
  org: ID
  name: String!
  type: ComponentType!
  defaultBranch: String
  versionSchema: String
  marketingVersionSchema: String
  versionType: VersionType
  featureBranchVersioning: String
  vcs: ID
  vcsRepository: VcsRepositoryInput
  includeApi: Boolean
  approvalPolicy: ID
  identifiers: [IdentifierInput]
  nature: ComponentNature
  deviceClass: DeviceClass
  medicalProfile: MedicalProfileInput
  repoPath: String
  branchSuffixMode: BranchSuffixMode
  """
  Component-level sid override. Only writeable when the org is in ENABLED_FLEXIBLE;
  the mutation layer rejects ENABLE/DISABLE writes otherwise (D3).
  """
  sidPurlOverride: SidPurlOverride
  """
  Component-level authority segments. May be set even when sidPurlOverride is INHERIT --
  the segments only take effect once a higher level enables sid for this component.
  """
  sidAuthoritySegments: [String!]
  """
  Whether this component is the tenant's own software (INTERNAL) or a tracked
  third-party dependency (EXTERNAL). Defaults to INTERNAL when null. EXTERNAL
  components never receive a platform-stamped sid PURL (D16).
  """
  isInternal: BelongsToOrganization
}

input AddArtifactInput {
  release: ID
  component: ID
  version: String
  releaseArtifacts: [ArtifactInput]
  deliverableArtifacts: [DeliverableArtifactInput]
  sceArtifacts: [SceArtifactInput]
}

input ReleaseApprovalProgrammaticInput {
