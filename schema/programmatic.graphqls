  FALSE_POSITIVE
  NOT_AFFECTED
  RESOLVED
}

enum ViolationType {
  LICENSE
  SECURITY
  OPERATIONAL
}

type ArtifactChangelog {
  added: [DiffComponent]
  removed: [DiffComponent]
}

input PartyInput {
  roles: [PartyRole]
  bomRef: String
  priority: Int
  name: String
  address: AddressInput
  contacts: [PartyContactInput]
  url: String
  origin: OriginInput
}

