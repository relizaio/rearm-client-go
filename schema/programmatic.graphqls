"""
The agent tool's own session, as a client reports it. See Session.providerSessions.
"""
input ProviderSessionInput {
  """
  The tool, as a short lower-case identifier ("claude-code"). Stored lower-cased.
  """
  provider: String!
  """
  The tool's local id for the session -- for Claude Code, the id its transcript is filed
  under ($CLAUDE_CODE_SESSION_ID). Printable ASCII, no whitespace, at most 256 characters.
  """
  id: String!
  """
  The id a hosted surface of the tool knows the session by, when there is one -- for Claude
  Code, the bridge / web session id (session_...). Same character rules as id.
  """
  remoteId: String
}

"""
A client's description of its device. Each value is trimmed and clipped to 200 characters.
hostname is personal data and is shown only to org admins and the session's owner.
"""
input SessionDeviceInput {
  hostname: String
  os: String
  """
  The local UTC offset and zone abbreviation, e.g. "UTC+02:00 CEST".
  """
  timeZone: String
  """
  The client and its version, e.g. "rearm-cli/26.09.4".
  """
  client: String
}

"""
Where a usage report came from, which is also how far it is to be trusted.
"""
enum SessionUsageSource {
  SELF_REPORTED
  TRANSCRIPT
  OTEL
  PROVIDER
}

"""
One line of a usage report: one model, one hosting, one context band.
"""
input SessionUsageLineInput {
  model: String
  hosting: SessionUsageHosting
  """
  Floor of the pricing band these requests fall in, in tokens: 0 for the base
  band, 200000 above the long-context threshold. A number rather than a label,
  so it sorts and compares against a pricing entry's contextAboveTokens
  directly. Absent means the base band.
  """
  contextBand: Long
  requests: Int!
  inputTokens: Long!
  outputTokens: Long!
  cacheReadTokens: Long
  cacheWriteTokens: Long
  reasoningTokens: Long
  maxRequestContextTokens: Long
  minRequestContextTokens: Long
  reportedCostMicros: Long
}

"""
How a usage row found its task; the answer changes what the number means.
"""
enum SessionUsageAttribution {
  EXPLICIT
  IMPLICIT
  COORDINATOR
  UNATTRIBUTED
}

enum AgentStatus {
  ACTIVE
  ARCHIVED
}

enum AgentType {
  ROOT
  SUB
}

type AgentSessionCounts {
  openSessions: Int
  closedSessions: Int
}

type ApiKey {
  uuid: ID
  org: ID
  permissions: Permissions
  object: ID
  type: ApiTypeEnum
  keyOrder: String
  lastUpdatedBy: ID
  createdBy: ID
  accessDate: DateTime
  createdDate: DateTime
  notes: String
  status: ApiKeyStatus
  secrets: [ApiKeySecretInfo!]
  "FREEFORM keys: the user who requested the key and the only one who may mint or regenerate its secrets"
  holder: ID
  "Deactivated by an org admin: the owner or holder cannot re-activate it, only an admin can"
  adminDisabled: Boolean
  "MANUAL, or CLI_SESSION for a personal key a CLI browser login created for its session (deleted with the session)"
  origin: ApiKeyOrigin
  "FEDERATED rows: the external repository this identity stands for"
  federation: FederatedIdentity
  """
  Root agents this key is bound to via the agent-identity it
  resolves to (agent_identity_credentials). Empty until an agent
  has authenticated with this key at least once. FREEFORM keys only.
  """
  boundAgents: [Agent]
}

"""
Which CycloneDX spec a stored model card is written in. V1_6 and V2_0 rather than
"1.6" and "2.0" because those are not valid GraphQL enum values; the persisted
wire form is unchanged.
"""
enum ModelCardSpecVersion {
  V1_6
  V2_0
}

"""
What is true of a model regardless of who serves it. A typed record rather than a
free-form map: a routing floor reading contextWindow needs a number, and a typo in
a key used to become a fact nobody would ever read.
"""
type ModelFacts {
  contextWindow: Long
  maxOutputTokens: Long
  modalities: [Modality]
  hostingKind: ModelHostingKind
  """
  ISO-8601 date. A String rather than a scalar: the schema has no Date scalar,
  and adding one with its coercion for three fields is more surface than it buys.
  The Java side keeps LocalDate, so a malformed date fails when the catalogue loads.
  """
  releaseDate: String
  deprecatedAt: String
  knowledgeCutoff: String
}

"""
Where a model comes from: who built it and whether its weights are open. Provenance, not
capability -- how capable a model is lives in `strength`, which an operator sets and a role
requires.
"""
enum ModelTier {
  """
  Closed model from a frontier lab.
  """
  FRONTIER
  """
  Open weights, as released.
  """
  OPEN_WEIGHT_STOCK
  """
  Open weights tuned by this organization or a vendor.
  """
  OPEN_WEIGHT_FINE_TUNED
  """
  Closed model from any other vendor.
  """
  THIRD_PARTY_PROPRIETARY
  """
  This organization's own closed model.
  """
  FIRST_PARTY_PROPRIETARY
}

"""
A model's strength for one kind of work.
"""
type ModelRoleStrength {
  category: ModelRoleCategory!
  strength: Float!
}

"""
RESOLVED when the row is linked to a bundled catalogue entry or confirmed by an
admin; UNRESOLVED when it auto-created from a string nobody mapped. Unresolved
rows price nothing.
"""
enum ModelResolution {
  RESOLVED
  UNRESOLVED
}

"""
A dated rate, in micros per million tokens. Entries are never edited: a
correction is a new entry plus an expiry on the old one, so a recorded price
version always means the same numbers.
"""
type PricingEntry {
  uuid: ID
  effectiveFrom: DateTime
  effectiveTo: DateTime
  currency: String
  unit: PricingUnit
  inputMicros: Long
  outputMicros: Long
  cacheReadMicros: Long
  cacheWriteMicros: Long
  reasoningMicros: Long
  appliesTo: PricingSelector
  source: String
  note: String
  createdBy: ID
  createdAt: DateTime
}

"""
Expected/asserted state of a device (defaults from its shipment's release).
"""
type DevicePlan {
  expectedRelease: ID
}

"""
Phone-home / observed actual state (optional, expected-empty). Per-device.
"""
type ActualReport {
  reportedRelease: ID
  reportedAt: DateTime
  source: ReportSource
}

"""
821 tracking block -- meaningful for MEDICAL_TRACKED devices only. Per-device.
"""
type TrackingRecord {
  receivedDate: String
  patientId: String
  disposition: Disposition
  dispositionDate: String
}

"""
Latest observed software state, reconciled against the expected release tree.
"""
type ObservedState {
  reportedAt: DateTime
  source: ReportSource
  items: [ObservedItem]
  matchedCount: Int
  driftedCount: Int
  unknownCount: Int
}

"""
A window resolved for a shipment or a unit, with the level it came from.

The source matters to a generated document: a Device Support Statement produced from a
batch must be able to say whether the dates are the model's default or this batch's
override, because a reader comparing two statements for the same model needs to know why
they differ.

Null when the model declares nothing and the batch has not overridden it. A batch that
overrode the model with NO window is reported as an object with both dates null and source
SHIPMENT -- a statement the batch made, distinct from the model's silence.
"""
type ResolvedDeviceSupportWindow {
  eos: String
  eol: String
  source: DeviceWindowSource
}

"""
Where an actual report came from.
"""
enum ReportSource {
  PHONE_HOME
  MANUAL
  SUPPORT_TICKET
}

input ObservedDigestInput {
  identifier: String
  digest: String!
}

enum SignatureFormat {
  SSH
  GPG
  """
  Reserved for v2 -- trust anchored at CA, not per-key.
  """
  X509
}

enum SigningKeyOwnerType {
  AGENT
  COMMITTER
}

"""
What a hop in this role must leave behind: the mirror of AgentRequiredInputInput, and the other
half of the contract between roles. It is also the routing graph -- open items are sent to
whichever active role produces the specification they are about -- so a board whose roles declare
nothing routes every question to its coordinator instead.

QUESTIONS is refused here and in requiredInputs: a question is a side channel any role may emit,
never a role's contracted product or prerequisite.
"""
input AgentProducedOutputInput {
  specification: SpecificationType!
  scope: AgentInputScope
  """
  False makes it advisory, for roles that sometimes have nothing to write.
  """
  required: Boolean
}

"""
One model's strength for one role, overriding what the catalogue says about the model.
"""
input RoleModelStrengthInput {
  """
  A model in this organization's catalogue.
  """
  model: ID!
  strength: Float!
}

"""
What a task must be able to read before an agent may start it: the board's Ready rule.
"""
enum AgentInputKind {
  DOCUMENT
  RELEASE
}

"""
Which release a RELEASE requirement is about: any release of the component, or one linked to this very task.
"""
enum AgentInputScope {
  COMPONENT
  TASK
}

type DependencySpec {
  component: String!
  branch: String
  release: String
  status: Status
  isFollowVersion: Boolean
}

type BoardRequiredInputSpec {
  kind: AgentInputKind
  specification: SpecificationType
  scope: AgentInputScope
  component: String
  minLifecycle: ReleaseLifecycleEnum
  resolution: AgentInputResolution
}

"""
A document a board role is expected to publish; mirrors BoardRequiredInputSpec.
"""
type BoardProducedOutputSpec {
  specification: SpecificationType
  scope: AgentInputScope
  required: Boolean
}

"""
A role's model strength in portable form: override models by reference, not uuid.
"""
type BoardStrengthSpec {
  requiredStrength: Float
  strengthHeadroom: Float
  strengthCategory: ModelRoleCategory
  modelStrengths: [BoardModelStrengthSpec]
}

enum OrganizationType {
  DEFAULT
  REGULAR
}

type ApprovalRole {
  id: String
  displayView: String
}

type Terminology {
  featureSetLabel: String
}

type IgnoreViolation {
  licenseViolationRegexIgnore: [String]
  securityViolationRegexIgnore: [String]
  operationalViolationRegexIgnore: [String]
}

type Settings {
  declarativePrune: DeclarativePruneMode
  justificationMandatory: Boolean
  """
  How many finding priority levels this organization uses, 1 being the highest. Null
  means the default. Write side is SettingsInput.findingPriorityLevels, which bounds it.
  """
  findingPriorityLevels: Int
  branchSuffixMode: BranchSuffixMode
  vexComplianceFramework: VexComplianceFramework
  """
  Org-level mode for sid (Software IDentification) PURL emission. See SidPurlMode docs.
  Null is treated as DISABLED at resolution time.
  """
  sidPurlMode: SidPurlMode
  """
  Decoded authority segments used when emitting platform sid PURLs. The first segment is
  the authority (domain or registered name); subsequent segments are publisher / business
  unit / product line context. Required when sidPurlMode == ENABLED_STRICT; optional under
  ENABLED_FLEXIBLE (used as a fallback when components/perspectives don't supply their own);
  must be null/empty under DISABLED.
  """
  sidAuthoritySegments: [String!]
  """
  Retention window, in days, for the org's notification rows (outbox events,
  deliveries, read marks). Null means the 90-day default.
  """
  notificationRetentionDays: Int
  """
  The submission-level justification: what FDA L1021-1022 asks for literally, the reason
  per-component support information cannot be included. At the measured 2.3% upstream
  coverage this is the centre of a submission rather than a footnote.
  
Null is a real state, not a default. A document with an empty REQUIRED slot is blocked
  rather than generated with the section missing -- on a submission a reviewer expects
  gaps, but on the patient-facing Device Support Statement a silent gap is itself
  misleading under 502(a)(1). No product-shipped default text: these are the
  manufacturer's own commitments.
  """
  fdaAssessmentNarrative: String
  """
  Whether this org's exports carry its support attestations.
  
NULL MEANS DISABLED. The default is off: support properties do not appear in an
  export unless someone asks for them. It governs INJECTION only -- the
  forged-provenance strip runs on every egress whatever this says, because a
  security control and a content choice are not the same switch.
  """
  supportInjection: SupportInjectionSetting
  """
  Labeling VI.A.2: that patches and software updates may cease at end of support.
  """
  fdaPatchesMayCeaseStatement: String
  """
  Labeling VI.A.3: a REFERENCE to the controlled risk-transfer process -- an identifier or
  URL, never the process itself. Plans are design-history-file records, and a pasted copy
  becomes a second, unversioned original that drifts from the controlled one.
  """
  fdaRiskTransferProcessRef: String
  """
  Labeling VI.A.4: that end-user cybersecurity risk can be expected to increase over
  time.
  """
  fdaRiskIncreasesNotice: String
  """
  Org-wide default UI view (Security or DevOps) for users who have not
  picked one in their browser. Null means SECURITY.
  """
  defaultView: DashboardView
  """
  Guards declared once for the organization, each picking the components it governs by name
  pattern, the same way the org's approval-policy rules do.
  """
  actionGuards: [ActionGuard!]
}

"""
Org-wide PR-validation trigger rule. See
{@link Organization.globalPrValidationTriggerRules} for the priority
contract; see {@link VcsRepository.effectivePrValidationTrigger} for
how rules are resolved per repo.
"""
type GlobalPrValidationTriggerRule {
  """
  Display name; unique within the org.
  """
  name: String
  """
  Java regex matched against {@code VcsRepositoryData.uri} via
  {@code Pattern.matcher(uri).matches()} -- fully anchored. Operators
  write {@code github.com/myorg/.*} (no leading {@code ^}, no
  trailing {@code $}) and the engine anchors automatically.
  """
  uriPattern: String
  """
  Trigger spec. Same shape as a per-VCS trigger; must be of type
  EXTERNAL_VALIDATION and reference a GITHUB integration with the
  PR_VALIDATE capability in the same org.
  """
  trigger: ReleaseOutputEvent
}

"""
Org-wide approval-policy assignment rule. See
{@link Organization.globalApprovalPolicyRules} for the priority
contract and {@link Component.effectiveApprovalPolicy} for how rules
are resolved per component.
"""
type GlobalApprovalPolicyRule {
  """
  Display name; unique within the org.
  """
  name: String
  """
  Java regex matched against {@code Component.name} via
  {@code Pattern.matcher(name).matches()} -- fully anchored. Operators
  write {@code frontend-.*} (no leading {@code ^}, no trailing
  {@code $}) and the engine anchors automatically.
  """
  namePattern: String
  """
  Type filter. {@code COMPONENT} / {@code PRODUCT} restrict the
  match; {@code ANY} (also the default when null) matches both
  concrete component types.
  """
  componentType: ComponentType
  """
  Referenced approval policy UUID.
  """
  approvalPolicy: ID
  """
  Hydrated approval policy. Null when the referenced policy is missing/archived.
  """
  approvalPolicyDetails: ApprovalPolicy
}

"""
Org-wide team-assignment rule (T2). See
{@link Organization.globalTeamAssignmentRules} for the priority contract.
"""
type GlobalTeamAssignmentRule {
  """
  Display name; unique within the org.
  """
  name: String
  """
  Java regex matched against {@code ComponentData.name} via
  {@code Pattern.matcher(name).matches()} -- fully anchored. Operators write
  {@code frontend-.*} (no leading {@code ^}, no trailing {@code $}).
  """
  namePattern: String
  """
  Type filter; ANY (or null) matches both COMPONENT and PRODUCT.
  """
  componentType: ComponentType
  """
  Owner team (UserGroup) UUID; must exist and be active in this org.
  """
  ownerTeam: ID
}

"""
What has been claimed about a commit, and by whom.
"""
type CommitAttestation {
  """
  NONE, MINE, NOT_MINE, or CONFLICT when two different principals each say it is theirs.
  One principal's latest word replaces their earlier one, so disowning and then claiming is
  a correction rather than a conflict.
  """
  state: String
  """
  USER or AGENT, for the claim that made it accountable.
  """
  actorType: String
  actor: ID
  """
  Who that is, by name -- an email for a user, the agent's name for an agent.
  """
  actorName: String
  """
  When the standing claim was made.
  """
  claimedAt: DateTime
  """
  Why it stands as it does: "signed by an enrolled key", "unsigned, no attribution".
  """
  detail: String
  """
  Where each principal stands now, latest word per principal, newest first. This is what a
  contested commit needs to be resolvable: who says what, and which row to revoke.
  """
  claims: [CommitClaim]
}

"""
Compact CEL-facing view of an SCE's signature verdict. Surfaced as
{@code SourceCodeEntry.signature}; the underlying row lives in
signature_verifications.
"""
type SceSignature {
  state: SignatureVerificationState
  format: SignatureFormat
  signedByOwnerType: SigningKeyOwnerType
  signedByOwnerUuid: ID
  verifiedAt: DateTime
  keyFingerprint: String
}

enum AttributionState {
  UNATTRIBUTED
  RESOLVED
  REJECTED
}

"""
Where an artifact's bytes are stored.
- REARM: bytes live in ReARM's blob store; downloadable in-place
