  ENABLED
  DISABLED
}

enum DependencySource {
  MANUAL
  PATTERN
}

"""
Where a model was served from. Not an identity dimension -- the catalogue holds
one row per model and the Bedrock / Vertex / Azure forms resolve onto it -- but a
pricing one, because the same model bills differently per provider.
"""
enum SessionUsageHosting {
  DIRECT
  BEDROCK
  VERTEX
  AZURE
  OTHER
}

enum ApiTypeEnum {
  APPROVAL
  INSTANCE
  CLUSTER
  COMPONENT
  ORGANIZATION
  ORGANIZATION_RW
  FREEFORM
  "Personal key owned by a user: its permissions are a ceiling intersected with the owner's current permissions"
  USER
  "Identity row for one external repository trusted by the org's federated trust rules: no secret, permissions computed from the rules on every call"
  FEDERATED
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  "Delete tombstone; never listed, and setApiKeyStatus refuses it (delete the key instead)"
  REVOKED
  "A free-form key a write user asked for: listed, never usable, until an admin approves (ACTIVE) or denies it"
  REQUESTED
  "A denied request: listed for the requester with the reason in the notes, never usable"
  DENIED
}

"""
One of up to two secrets of a key id (rotation: add the second, move clients, retire the first).
Only metadata: the secret itself is shown once, when created or regenerated.
"""
type ApiKeySecretInfo {
  slot: Int!
  active: Boolean!
  createdDate: DateTime
  lastUsedDate: DateTime
  "Optional hard stop; past it the secret is refused like a retired one, and its tokens end here at the latest"
  expiresDate: DateTime
}

"""
Kill switch for a whole key id: INACTIVE refuses every secret and every token issued for the key, without deleting anything.
"""
enum ApiKeyOrigin {
  MANUAL
  CLI_SESSION
}

"The external repository behind a FEDERATED key row, with the ids pinned on first use"
type FederatedIdentity {
  provider: FederatedProvider
  issuer: String
  owner: String
  repository: String
  repositoryUri: String
  repositoryId: String
  ownerId: String
  pinnedDate: DateTime
  lastRef: String
  lastRunId: String
  lastActor: String
}

"""
What a model can read and write.
"""
enum Modality {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

"""
How a model is served. Distinct from SessionUsageHosting, which says where ONE
request went; this says what kind of thing the model is.
"""
enum ModelHostingKind {
  API
  SELF_HOSTED
  EMBEDDED
}

"""
What pricing rates are quoted per.
"""
enum PricingUnit {
  PER_MILLION_TOKENS
}

"""
Which rows an entry applies to. Every stated field must match; the entry with the
most fields stated wins, so a base rate and a qualified rate coexist without
priority rules.
"""
type PricingSelector {
  """
  Matches when a request's FULL context -- input plus cache read plus cache
  write -- exceeds this. Not inputTokens, which with prompt caching counts only
  the uncached remainder and on a long session never approaches a threshold.
  """
  contextAboveTokens: Long
  contextVariant: String
  serviceTier: ServiceTier
  hosting: SessionUsageHosting
  reasoning: ReasoningMatch
}

"""
821 disposition lifecycle of a shipped (tracked) unit.
"""
enum Disposition {
  SHIPPED
  RECEIVED
  RETURNED
  EXPLANTED
  DISPOSED
  DONATED
  LOST
}

"""
One reconciled observed item (e.g. a running container image digest).
"""
type ObservedItem {
  identifier: String
  digest: String
  status: ObservedItemStatus
  deliverable: ID
  component: ID
  componentName: String
  observedRelease: ID
  observedVersion: String
  expectedRelease: ID
  expectedVersion: String
}

"""
Which level a resolved device window was declared at.
"""
enum DeviceWindowSource {
  """
  The product component -- the device model's default.
  """
  COMPONENT
  """
  The shipment -- this batch differs from the model.
  """
  SHIPMENT
}

type BoardModelStrengthSpec {
  """
  The model's canonical id, or name-version: resolved through the organization's model aliases.
  """
  model: String
  strength: Float
}

"""
How rows absent from an applied spec are treated. LEAVE (default) reports them; ARCHIVE archives them.
"""
enum DeclarativePruneMode {
  LEAVE
  ARCHIVE
}

"""
VEX compliance framework layered on top of the CycloneDX baseline data model.
NONE  = pure CycloneDX, no extra validation.
CISA  = CISA VEX minimum requirements
        (https://www.cisa.gov/sites/default/files/2023-04/minimum-requirements-for-vex-508c.pdf).
"""
enum VexComplianceFramework {
  NONE
  CISA
}

"""
Org-level sid PURL emission policy. D11 / D15.
- DISABLED: no sid emission; tenant-supplied pkg:sid/... values pass through unchanged.
- ENABLED_STRICT: sid emitted org-wide; component/perspective overrides not honored;
  the org authority applies to every internal component.
- ENABLED_FLEXIBLE: sid emitted org-wide, but components and (SaaS) perspectives
  may override the per-component decision and supply their own authority.

Enabling sid is forward-only -- releases created before the toggle retain their
existing identifiers unchanged.
"""
enum SidPurlMode {
  DISABLED
  ENABLED_STRICT
  ENABLED_FLEXIBLE
}

"""
Whether an organization's BOM exports carry its support attestations.

Two values, and deliberately not four: SupportExportState's PARTIAL and UNKNOWN are things
OBSERVED about a running system, not things an operator chooses. Storing either would let
an operator configure a state meaning "we are not sure what we do".
"""
enum SupportInjectionSetting {
  """
  Exports carry the attestations. Applies to the native single-artifact download, the
  SPDX-augmented download and the merged release export -- NOT the raw artifact download,
  which is swept for forged reliza:* provenance and marked, but never injected into, on any
  setting.
  """
  ENABLED
  """
  Exports carry no support properties. The default, including when the field is unset.
  
It does not disable the forged-provenance strip, which runs on every egress regardless:
  a security control and a content choice are not the same switch.
  """
  DISABLED
}

"""
UI views the dashboard and component pages can show. Selected per browser
in the header; the org's default (Settings.defaultView) applies when the
browser has no choice stored.
"""
enum DashboardView {
  SECURITY
  DEVOPS
}

"""
One principal's standing statement about a commit.
"""
type CommitClaim {
  """
  The attestation row, so it can be revoked by whoever needs to withdraw it.
  """
  uuid: ID
  """
  MINE or NOT_MINE.
  """
  verdict: String
  """
  USER or AGENT.
  """
  actorType: String
  actor: ID
  """
  Who that is, by name.
  """
  actorName: String
  note: String
  createdDate: DateTime
}

enum SignatureVerificationState {
  """
  No signature artifact attached.
  """
  UNSIGNED
  """
  Cryptographic check passed and signer resolved to an enrolled key.
  """
  VERIFIED
  """
  Cryptographic check failed.
  """
  INVALID_SIGNATURE
  """
  Signature parsed but the signer key is not enrolled in this org.
  """
  UNKNOWN_KEY
  """
  Signer key was matched but is revoked.
  """
  KEY_REVOKED
  """
  Reserved for v2 -- attribution constraint failure decoupled from trust-store scope (e.g. image / attestation flows where the verifier's scope and the expected attribution can legitimately differ). Not produced in v1; the verifier narrows scope upfront from the SCE so a mismatched owner can't reach this branch.
  """
  WRONG_SIGNER
  """
  Verification was scheduled but has not yet run.
  """
  PENDING
  """
  Verifier subprocess errored -- see {@code details} for diagnostics.
  """
  ERRORED
}

