  latitude: Float
  longitude: Float
}

input CoordsInput {
  latitude: Float
  longitude: Float
}

"""Where a usage report came from, which is also how far it is to be trusted."""
enum SessionUsageSource { SELF_REPORTED TRANSCRIPT OTEL PROVIDER }

"""
Where a model was served from. Not an identity dimension -- the catalogue holds
one row per model and the Bedrock / Vertex / Azure forms resolve onto it -- but a
pricing one, because the same model bills differently per provider.
"""
enum SessionUsageHosting { DIRECT BEDROCK VERTEX AZURE OTHER }

"""How a usage row found its task; the answer changes what the number means."""
enum SessionUsageAttribution { EXPLICIT IMPLICIT COORDINATOR UNATTRIBUTED }

"""One line of a usage report: one model, one hosting, one context band."""
input SessionUsageLineInput {
  model: String
  hosting: SessionUsageHosting
  """
  Floor of the pricing band these requests fall in, in tokens: 0 for the base
  band, 200000 above the long-context threshold. A number rather than a label,
  so it sorts and compares against a pricing entry's contextAboveTokens
  directly. Absent means the base band.
  """
  contextBand: Long
  requests: Int!
  inputTokens: Long!
  outputTokens: Long!
  cacheReadTokens: Long
  cacheWriteTokens: Long
  reasoningTokens: Long
  maxRequestContextTokens: Long
  minRequestContextTokens: Long
  reportedCostMicros: Long
}

input SessionUsageReportInput {
  sessionUuid: ID
  clientSessionId: String
  """Monotonic per session; the transcript byte offset in the CLI, so 64-bit."""
  clientSeq: Long!
  source: SessionUsageSource!
  windowStart: DateTime
  windowEnd: DateTime
  turns: Int
  toolCalls: Int
  wallSeconds: Int
  reasoningLevel: String
  taskUuid: ID
  raw: Object
  lines: [SessionUsageLineInput!]!
}

type SessionUsageAck {
  accepted: Int!
  duplicates: Int!
  """One message per line that could not be filed, with the reason."""
  refused: [String!]!
  attribution: SessionUsageAttribution!
  task: ID
}

"""Specification document types a component may carry."""
enum SpecificationType {
  CONOPS
  USE_CASES
  REQUIREMENTS
  FUNCTIONS
  PRODUCT_BREAKDOWN
  INTERFACES
  DATA_MODEL
  ARCHITECTURE
  DETAILED_DESIGN
  UX_CONCEPT
  TEST_PLAN
  GLOSSARY
  DECISION_RECORD
  """One review round of one task. Task-scoped."""
  REVIEW_FINDINGS
  """One test run of one task. Task-scoped."""
  TEST_REPORT
  """Questions one hop asked about one of its inputs; routed to whoever produces that input."""
  QUESTIONS
}

"""What an agent states about a document it has already committed."""
input AgentDocumentPublishInput {
  sessionUuid: ID!
  """Required for TASK-scoped types (REVIEW_FINDINGS, TEST_REPORT)."""
  taskUuid: ID
  specification: SpecificationType!
  """Required for COMPONENT-scoped types: which document series this belongs to."""
  component: ID
  """
  Repo-relative path. Omit it, with digest, commit and vcsUri, to publish an index alone --
  a QUESTIONS round usually has no prose worth committing.
  """
  path: String
  """sha256 of the file at that path. Required with a path."""
  digest: String
  mediaType: String
  indexPath: String
  indexDigest: String
  """The findings index. Required for REVIEW_FINDINGS, TEST_REPORT and QUESTIONS."""
  index: Object
  """HEAD of the documents repository when the files were read. Required with a path."""
  commit: String
  """The documents repository, as a git URI. Required with a path."""
  vcsUri: String
  commitMessage: String
  commitDate: DateTime
  lifecycle: ReleaseLifecycleEnum
}
