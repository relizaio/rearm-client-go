# ReARM programmatic API contract. Generated from programmatic.graphqls and the types it reaches;
# served at /api/programmatic/schema. Consumed by rearm-client-go and the Terraform provider.

type Query {
  """
  Export the Catalog slice of the key's org as a spec (CONFIGURATION_READ); optionally only the named components.
  """
  exportCatalogProgrammatic(
  components: [String!]): CatalogSpec
  """
  Export the Branches slice of one component / product as a spec (CONFIGURATION_READ).
  """
  exportBranchesProgrammatic(
  component: String!): BranchesSpec
  release(releaseUuid: ID!, orgUuid: ID): Release
  getSbomProbingResult(runId: String!): SbomProbingResult
  getReleaseByHashProgrammatic(hash: String!, componentId: ID): String
  """
  Exact-version lookup. Returns the release's OBOM (CycloneDX 1.6: the release
  plus every dependency release unwound, with deliverables) as a JSON string,
  or "{}" when the version does not exist on the component / product.
  Lifecycle and approvals are not consulted: the named version is returned as is.
  componentId is the component / product uuid, or -- with an organization-scoped
  key -- its name: matched case-insensitively against the org's active components
  and products, exactly one hit required (unknown or ambiguous names error).
  """
  getReleaseByReleaseVersionProgrammatic(
  version: String!
  componentId: ID!): String
  getLatestReleaseProgrammaticCdx(release: GetLatestReleaseInput!): String
  getLatestReleaseProgrammatic(release: GetLatestReleaseInput!): Release
  getInstanceRevisionCycloneDxExportProg(instanceUuid: ID, instanceUri: String, revision: Int!, namespace: String, stateType: InstanceStateType): String
  isInstanceHasSealedSecretCert(instanceUuid: ID, instanceUri: String): Boolean
  getInstancePropSecrets(instanceUuid: ID, instanceUri: String, namespace: String!, revision: Int!, properties: [String], secrets: [String], product: ID, productSpecificProps: Boolean): PropSecrets
  deliverableDownloadSecrets(instanceUuid: ID, instanceUri: String, deliverableDigest: String!, namespace: String, releaseNs: String): ComponentAuthentication
  listInstanceProductFeatureSets(instanceUuid: ID, instanceUri: String, namespace: String): [InstanceProductFeatureSets!]!
  """
  Programmatic poll endpoint for an agent's session -- returns
  actionable events (lifecycle changes on attributed releases,
  approval flips, new session policy verdicts) strictly after the
  supplied cursor. Auth: FREEFORM key bound to the session's owning
  agent identity. Designed for closed-loop "disapproval → agent
  fix" flows; see {@code /api/agents/orientation.md} for the
  canonical polling cadence.
  """
  agentSessionInboxProgrammatic(
  inboxRequest: AgentSessionInboxInput!): [AgentSessionInboxEvent!]!
  """
  FREEFORM-auth read of a single session by uuid. Returns null when
  the session does not exist or is owned by a different org than the
  calling key. The JWT-authenticated {@code session} query is the
  operator/UI path; this is the agent's path for fetching its own
  full session state (policy verdicts, releases, PRs) after an inbox
  event.
  """
  sessionProgrammatic(
  sessionUuid: ID!): Session
  """
  FREEFORM-auth read of a single release by uuid, scoped to the
  calling agent's session. The caller must pass either {@code
  sessionUuid} (the row uuid returned by {@code sessionInitializeProgrammatic})
  or {@code clientSessionId} (the agent-chosen id). Authorization
  chain: (a) calling key carries {@code PermissionFunction.AGENT}
  at {@code ORGANIZATION} scope; (b) the session's owning agent
  belongs to the calling key's identity; (c) the requested release
  is attributed to that session (its commits trace through to this
  release). Any failure throws {@code AccessDeniedException} and
  is logged SECURITY-level. Used by agents after a LIFECYCLE_CHANGE
  / APPROVAL inbox event to pull updateEvents + approvalEvents on
  the release.
  """
  agenticReleaseProgrammatic(
  releaseUuid: ID!
  sessionUuid: ID
  clientSessionId: String): Release
}

type Mutation {
  """
  Declarative apply of the Catalog slice (API key, write access on the org). Idempotent, keyed by
  component name. dryRun computes the change set without writing.
  """
  applyCatalogProgrammatic(
  spec: CatalogSpecInput!
  dryRun: Boolean
  source: DeclarativeSourceInput): DeclarativeApplyResult
  """
  Declarative apply of the Branches slice for one component / product (API key, write access on the
  org). Idempotent, keyed by branch name. Branches absent from the spec follow Settings.declarativePrune.
  """
  applyBranchesProgrammatic(
  spec: BranchesSpecInput!
  dryRun: Boolean
  source: DeclarativeSourceInput): DeclarativeApplyResult
  """
  Programmatic (API-key) upsert of a PullRequest. CI registers the PR
  row independently of release creation so the registration survives
  push/pull_request races and DO_BUILD=false short-circuits.
  Idempotent on (targetVcsRepository, identity) -- safe to call
  multiple times per CI run (e.g. once per component in a monorepo).
  When `commit` is supplied and an SCE already exists for
  (targetVcs, commit), the head is advanced to that SCE in the same
  call; otherwise the PR row is registered without a head and the
  subsequent addReleaseProgrammatic call (which carries the same PR
  input) will advance the head once the SCE is persisted.
  Resolves the target VCS by `vcsUri`+`repoPath` (FREEFORM or
  ORGANIZATION_RW key) or by `component` UUID (COMPONENT,
  FREEFORM, or ORGANIZATION_RW key). Accepts COMPONENT, FREEFORM,
  or ORGANIZATION_RW API keys; other ORGANIZATION_* types are
  rejected.
  """
  upsertPullRequestProgrammatic(
  input: PullRequestUpsertProgrammaticInput!): PullRequest
  getNewVersionProgrammatic(newVersionInput: GetNewVersionInput!): Version
  addReleaseProgrammatic(release: ReleaseInputProg!): Release
  """
  Batch counterpart to addReleaseProgrammatic. Creates every supplied
  release in a single all-or-nothing transaction -- if any entry fails,
  none are persisted. Auto-integration of products is deferred until all
  releases are created, then fired once per affected feature set (deduped
  across the whole batch) instead of once per release. Use this when a CI
  run builds several component releases at once and you want a single
  product auto-integrate rather than one per component version.
  """
  addReleasesProgrammatic(
  releases: [ReleaseInputProg!]!): [Release]
  addOutboundDeliverablesProgrammatic(deliverables: AddODeliverableInput!): Release
  createComponentProgrammatic(component: CreateComponentInput!): Component
  """
  Programmatic counterpart to createComponentInPerspective. Requires a FREEFORM API key
  with WRITE permission on the supplied perspective (or a broader scope that covers it).
  Only real perspectives (PerspectiveType.PERSPECTIVE) are accepted -- product-derived
  perspectives are rejected.
  """
  createComponentInPerspectiveProgrammatic(
  component: CreateComponentInput!
  perspectiveUuid: ID!): Component
  addArtifactProgrammatic(artifactInput: AddArtifactInput): Release
  approveReleaseProgrammatic(releaseApprovals: ReleaseApprovalProgrammaticInput!): Release
  synchronizeLiveBranches(synchronizeBranchInput: SynchronizeBranchInput!): Boolean
  probeSbomProgrammatic(sbom: String!, componentUuid: ID, branchUuid: ID): SbomProbingRun
  releasecompletionfinalizerProgrammatic(release: ID!): Boolean
  instData(instance: InstanceDataInput!): Object
  instanceDeploymentEventsProgrammatic(events: [InstanceDeploymentEventInput!]!): Object
  setInstanceSealedSecretCert(sealedCert: String!): Boolean
  """
  Switch a product deployment on the instance plan to another feature set of the same product.
  release: optional release uuid or version on the new feature set; pins the deployment to it
  (the plan entry becomes TARGET). follow: optional, true returns the entry to FOLLOW. Without
  either, the integrate type is kept and the previous target release is cleared.
  """
  switchInstanceProductFeatureSet(
  instanceUuid: ID
  instanceUri: String
  productUuid: ID!
  featureSetUuid: ID!
  namespace: String
  release: String
  follow: Boolean): Instance
  versionFeatureSet(productUuid: ID!, overrides: [VersionFeatureSetOverride!]!): Branch
  sessionInitializeProgrammatic(sessionInit: SessionInitializeInput!): Session
  sessionTouchProgrammatic(sessionUuid: ID!): Session
  sessionCloseProgrammatic(sessionUuid: ID!): Session
  sessionAddArtifactProgrammatic(addArtifact: SessionAddArtifactInput!): Session
  sessionUpdateMetaProgrammatic(updateMeta: SessionUpdateMetaInput!): Session
  spawnSubAgentProgrammatic(spawnSubAgent: SpawnSubAgentInput!): Agent
  setModelOntologyModelCardProgrammatic(input: SetModelCardInput!): ModelOntology
  reportDeviceState(report: DeviceStateReportInput!): Device
  enrollSigningKeyProgrammatic(signingKey: AgentSigningKeyInput!): SigningKey
}

type CatalogSpec {
  kind: DeclarativeKind!
  version: Int!
  authoritative: Boolean!
  components: [CatalogComponent!]!
}

type BranchesSpec {
  kind: DeclarativeKind!
  version: Int!
  component: String!
  authoritative: Boolean!
  branches: [BranchSpecEntry!]!
}

type Release {
  uuid: ID
  version: String
  marketingVersion: String
  status: Status
  lifecycle: ReleaseLifecycleEnum
  """
  Computed (Distribution): true when this release's component is HARDWARE, or --
  for a product release -- when at least one constituent component release is.
  """
  hardware: Boolean
  org: ID
  orgDetails: Organization
  component: ID
  componentDetails: Component
  branch: ID
  branchDetails: Branch
  parentReleases: [ParentRelease]
  sourceCodeEntry: ID
  sourceCodeEntryDetails: SourceCodeEntry
  commits: [ID]
  commitTime: DateTime
  commitsDetails: [SourceCodeEntry]
  """
  Pull requests this release participates in -- any PR whose commits[]
  intersects this release's commits[]. Computed at read time; resolves
  by matching SCE UUIDs.
  """
  pullRequests: [PullRequest]
  artifacts: [ID]
  artifactDetails: [Artifact]
  inboundDeliverables: [ID]
  inboundDeliverableDetails: [Deliverable]
  tickets: [ID]
  ticketDetails: [Ticket]
  notes: String
  decoratedVersionString: String
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  endpoint: String
  inProducts: [Release]
  vcsRepository: VcsRepository
  tags: [TagRecord]
  approvedEnvironments: [String]
  approvalEvents: [ReleaseApprovalEvent]
  approvalRequests: [ReleaseApprovalRequest]
  variantDetails: [Variant]
  updateEvents: [ReleaseUpdateEvent]
  metrics: DependencyTrackMetrics
  identifiers: [Identifier]
  gudidRecord: GudidRecord
  gudidStatus: GudidStatus
  eos: String
  eol: String
  """
  Component name snapshot captured when a sid PURL was first emitted for this release (D6).
  Immutable once set. Null on releases pre-dating sid enablement and on releases of
  EXTERNAL components.
  """
  sidComponentName: String
  """
  Resolved BOM root identifier per the D4 picker: sid PURL > any other PURL >
  release UUID. Always non-null. Used by the UI to display the canonical
  identifier and matches what VDR / OBOM / aggregated-SBOM emit at the BOM root.
  """
  preferredBomIdentifier: String
  releaseCollection: ReleaseCollection
  """
  Adjacent releases on this release's own branch / feature set, ordered by
  created date (the same CANCELLED-excluding lineage used for the SBOM-component
  changelog). previousRelease is the release created immediately before this one
  on the branch, nextRelease the one immediately after; both are null at the
  branch's first / last release. Unlike the changelog baseline these do NOT fall
  back to a base-branch fork point -- navigation stays within the same branch.
  Lazily resolved: only queried when selected. Select a light subselection
  (e.g. uuid version lifecycle createdDate) -- used by the release view's
  prev/next navigation arrows.
  """
  previousRelease: Release
  nextRelease: Release
  intermediateFailedReleases: [IntermediateFailedRelease]
  sbomReconcilePending: Boolean
  """
  Distinct AgentSessions whose commits contributed to this release.
  Walks release.commits -> SCE.agentSession (the forward pointer set
  by the PR 2 commit-trailer parser) and dedupes. Empty list when
  no commits carry agent attribution.
  """
  sessions: [Session]
}

type SbomProbingResult {
  status: SbomProbingStatus!
  metrics: DependencyTrackMetrics
}

input GetLatestReleaseInput {
  """
  Component / product uuid, or -- with an organization-scoped key -- its name:
  matched case-insensitively against the org's active components and products,
  exactly one hit required (unknown or ambiguous names error).
  """
  component: ID
  product: ID
  branch: String
  tags: [TagRecordInput]
  lifecycle: ReleaseLifecycleEnum
  conditions: ConditionGroupOnGetLatestReleaseInput
  vcsUri: String
  repoPath: String
  upToVersion: String
  """
  Only consider releases whose approvedEnvironments contains this built-in
  environment (DEV, BUILD, TEST, SIT, UAT, PAT, STAGING, PRODUCTION; case-insensitive).
  Orthogonal to lifecycle and conditions: they are applied on top when set.
  Environment approvals are granted by an ADD_APPROVED_ENVIRONMENT trigger or an
  admin override; a later policy disapproval does not revoke them (only an admin
  override removes), so combine with approval-entry conditions when the current
  approval state matters. Like conditions, this scans the newest 300 releases
  of the branch.
  """
  approvedEnvironment: String
}

enum InstanceStateType {
  PLAN
  ACTUAL
}

type PropSecrets {
  properties: [KeyValue]
  secrets: [KeyValue]
}

type ComponentAuthentication {
  login: String
  password: String
  type: String
}

type InstanceProductFeatureSets {
  namespace: String
  product: NamedRef!
  currentFeatureSet: NamedRef
  """
  Integrate type of the plan entry: FOLLOW (latest release approved for the instance environment),
  TARGET (pinned release), INTEGRATE, NONE or UNINSTALL.
  """
  integrateType: IntegrateType
  """
  Release the plan currently aims at: the FOLLOW-resolved release or the pinned TARGET release.
  Null when nothing is selected yet (TARGET without a release, or no approved release).
  """
  targetRelease: FeatureSetReleaseRef
  """
  Release the instance actually reports as running for this product (matched from agent data).
  Null when nothing has matched yet.
  """
  deployedRelease: FeatureSetReleaseRef
  availableFeatureSets: [FeatureSetOption!]!
}

"""
One actionable event the agent owning a session needs to react to --
typically a release minted from the session's commits changing
lifecycle (REJECTED by a CEL gate, ASSEMBLED, etc.) or carrying a
new approval (DISAPPROVED with reviewer comment is the canonical
"agent fix loop" trigger). Polled by the agent via
{@code agentSessionInboxProgrammatic} with a cursor it stores
client-side.
"""
type AgentSessionInboxEvent {
  """
  Opaque, monotone cursor token. Pass back as the {@code since}
  field on the next poll to fetch strictly newer events. Stable --
  the same event always returns the same cursor.
  """
  cursor: String!
  occurredAt: DateTime!
  kind: AgentInboxEventKind!
  """
  Release this event is about, when {@code kind} is release-side
  (LIFECYCLE_CHANGE / APPROVAL). Null on session-side events
  (POLICY_VERDICT).
  """
  release: Release
  """
  Previous value, when meaningful (e.g. prior lifecycle).
  """
  oldValue: String
  """
  New value (e.g. new lifecycle, "DISAPPROVED").
  """
  newValue: String
  """
  Free-form human-readable reason for the event:
    - LIFECYCLE_CHANGE: the matching ReleaseUpdateEvent.message
      (e.g. "Triggered by 'Reject when any commit is not VERIFIED'
      (CEL: …)") -- what *caused* the lifecycle change.
    - APPROVAL: the reviewer's free-text comment when
      DISAPPROVED; null on APPROVED unless a comment was left.
    - POLICY_VERDICT: the failing policy's failure message.
  """
  reason: String
  source: AgentInboxSource!
  """
  User uuid that authored the change, when {@code source = HUMAN}.
  Null for automated / policy-driven events.
  """
  actorUuid: ID
  """
  Approval role id ({@code ApprovalEntry.roleId} snapshot), when {@code kind = APPROVAL}.
  """
  actorRoleId: String
}

input AgentSessionInboxInput {
  sessionUuid: ID!
  """
  Opaque cursor from a prior poll. Null = "from session start".
  Server returns events strictly after this cursor.
  """
  since: String
  """
  Optional filter; null = all kinds.
  """
  kinds: [AgentInboxEventKind!]
  """
  Default 50; capped at 200.
  """
  limit: Int
}

"""
One ROOT Agent invocation. Many concurrent sessions per agent are
allowed on the same API key. Sub-agents of the root contribute
commits / artifacts to the same session via the commit-trailer
attribution path (PR 2).
"""
type Session {
  uuid: ID
  org: ID
  """
  Owning ROOT agent uuid.
  """
  agent: ID
  """
  Agent-supplied natural session id. Defaults to the row uuid when
  the agent didn't pick one on initialize. The two-line commit
  trailer references this value, not the row uuid.
  """
  clientSessionId: String
  """
  API key the agent used to open the session.
  """
  apiKey: ID
  title: String
  status: SessionStatus
  startedAt: DateTime
  closedAt: DateTime
  lastActivityAt: DateTime
  """
  Artifact UUIDs attached to this session (reuses rearm.artifacts).
  """
  artifacts: [ID]
  """
  SCE UUIDs attributed to this session via the commit-trailer parser
  (PR 2). Order is append-order; head of list is the earliest commit.
  """
  commits: [ID]
  """
  Append-only log of agent-policy evaluations (PR 4). Empty on CE
  deployments and on sessions opened under an org with no policies.
  """
  policyEvents: [PolicyEvent]
  """
  Releases produced from this session's commits. Computed at read
  time by walking `commits → Release.sourceCodeEntry` (and
  `commits[]` for multi-commit releases). Distinct on release uuid.
  """
  releases: [Release]
  """
  Pull requests touched by this session's commits. Computed at read
  time by walking `commits → PullRequest.commits[]`. Distinct on
  PR uuid.
  """
  pullRequests: [PullRequest]
  """
  If this session was opened by an agent retrying after a prior
  BLOCKED / CLOSED predecessor, this is that predecessor's uuid.
  Null on first-time sessions.
  """
  parentSession: ID
  """
  The AI model this session ran. The model is a property of the chat,
  not the durable agent -- set from the agent's declared model on
  initialize. Null on legacy sessions written before per-session model
  tracking existed. Prefer this over the deprecated Agent.model.
  """
  primaryModel: ModelOntology
  """
  How much trust primaryModel carries. DECLARED = the agent self-
  reported the model string (the only source today). RUNTIME_OBSERVED is
  reserved for host-side hooks that read the model from the runtime's own
  record; not yet emitted. The UI must not imply the model carries the
  session signature's authority.
  """
  modelAssertion: ModelAssertionState!
  createdDate: DateTime
}

type DeclarativeApplyResult {
  kind: DeclarativeKind!
  dryRun: Boolean!
  specHash: String!
  changes: [DeclarativeChange!]!
  created: Int!
  updated: Int!
  unchanged: Int!
  archived: Int!
  errors: Int!
}

"""
Catalog slice: components and products of an organization (no branches, no releases).
"""
input CatalogSpecInput {
  """
  Must be CATALOG; the file's kind is validated against the operation.
  """
  kind: DeclarativeKind!
  version: Int!
  """
  When true the file claims every active component / product of the org: with
  Settings.declarativePrune = ARCHIVE, components not listed are archived. Partial
  files (per team) leave this false.
  """
  authoritative: Boolean
  components: [CatalogComponentInput!]!
}

"""
Where an applied spec came from, recorded on every row the apply touched.
"""
input DeclarativeSourceInput {
  repo: String
  path: String
  commit: String
}

"""
Branches slice: branches of a component, or feature sets of a product. The file is authoritative for that component.
"""
input BranchesSpecInput {
  """
  Must be BRANCHES; the file's kind is validated against the operation.
  """
  kind: DeclarativeKind!
  version: Int!
  """
  Component or product name.
  """
  component: String!
  """
  When true (the default for files) the spec claims every non-base branch of the component and
  Settings.declarativePrune decides what happens to branches it does not list. Single-branch
  callers such as the Terraform provider pass false.
  """
  authoritative: Boolean
  branches: [BranchSpecInput!]!
}

"""
First-class PullRequest entity. Owns its own identity at the SCM level
(target VCS + identity string), its own commit list (SCE UUIDs), and
both inbound (release_validation_events) and outbound
(pr_validation_events) event streams.
"""
type PullRequest {
  uuid: ID
  org: ID
  targetVcsRepository: ID
  sourceVcsRepository: ID
  identity: String
  state: String
  title: String
  sourceBranchName: String
  targetBranchName: String
  endpoint: String
  commits: [ID]
  prCreatedDate: DateTime
  closedDate: DateTime
  mergedDate: DateTime
  createdDate: DateTime
  prValidationEvents: [PullRequestValidationEvent]
  releaseValidationEvents: [ReleaseValidationEvent]
  """
  Releases currently attributed to this PR -- every release whose
  primary sourceCodeEntry is one of the PR's commits, scoped to
  the PR's org. Same logic the aggregator uses to compute the
  PR-level verdict (no dispatch is triggered). Empty when the PR
  has no commits or no releases have been minted against any of
  them yet.
  """
  attributedReleases: [Release]
  """
  Hydrated commit list -- SCE rows for every entry in `commits`.
  Order matches `commits` (head is the last element). Used by the
  UI to render the actual git commit SHA / message / author
  instead of just the SCE UUID. Missing SCEs (e.g. one that was
  since archived) are silently dropped.
  """
  commitDetails: [SourceCodeEntry]
  """
  Releases referenced by any release_validation_event in this PR's
  history -- superset of attributedReleases. Required so the UI can
  display release names for events whose release has since been
  superseded (newest-per-component attribution drops the older
  release from attributedReleases but its event row remains).
  Distinct on UUID; missing releases (archived) are silently dropped.
  """
  validatedReleaseDetails: [Release]
  """
  Latest pr_validation_event verdict whose sourceCodeEntry matches
  the PR's current head commit. Mirrors the aggregator's
  "latest-for-head" lookup so this resolver and the SCM dispatch
  read the same value. {@code null} when the PR has no commits, no
  validation events, or no event for the current head -- UI should
  render that as "pending / not yet validated".
  """
  currentValidationState: ValidationState
  """
  Distinct ROOT agents that contributed to this PR -- walks
  `commits → SCE.agent → resolveRoot`. One PR can be attributed to
  multiple agents (different commits from different sessions / keys).
  Empty when no commits carry agentic attribution. Order is by first
  appearance in `commits`.
  """
  agents: [Agent]
}

input PullRequestUpsertProgrammaticInput {
  identity: String!
  state: String!
  title: String
  sourceBranchName: String
  targetBranchName: String
  endpoint: String
  """
  Target VCS resolution. With a COMPONENT API key the component is
  implicit (the key identifies it) -- `component` / `vcsUri` are not
  needed. With an ORGANIZATION_RW or FREEFORM key, supply either
  `component` (UUID of the target component, whose VCS is used) or
  the (`vcsUri`, `repoPath`) pair plus optionally `vcsDisplayName`.
  When both are present, `component` wins and vcsUri/repoPath are
  ignored.
  """
  component: ID
  vcsUri: String
  repoPath: String
  vcsDisplayName: String
  """
  When supplied, the backend looks up the SCE for (targetVcs, commit)
  and advances the PR head to it if found. If no SCE exists yet for
  that commit, the PR row is registered without a head -- the
  subsequent addReleaseProgrammatic call carrying the same PR input
  will advance the head once the SCE is persisted.
  """
  commit: String
}

type Version {
  version: String
  dockerTagSafeVersion: String
  changelog: String
  releaseAlreadyExists: Boolean
  """
  Lifecycle of the resolved release at the time getNewVersion returned.
  Reflects the state AFTER any synchronous component-trigger run during
  release creation -- so a CEL gate that pre-emptively moves the release
  to REJECTED is visible here. Callers (CLI / CI actions) should abort
  downstream build steps when this is a terminal state (REJECTED,
  CANCELLED) instead of charging into a subsequent addrelease that will
  collide on the (component, version) dedup gate. Null on the
  onlyVersion path (no release row was created).
  """
  lifecycle: ReleaseLifecycleEnum
}

input GetNewVersionInput {
  component: ID
  branch: String!
  modifier: String
  action: String
  metadata: String
  versionSchema: String
  lifecycle: ReleaseLifecycleEnum
  onlyVersion: Boolean
  sourceCodeEntry: SourceCodeEntryInput
  commits: [SourceCodeEntryInput]
  vcsUri: String
  repoPath: String
  vcsDisplayName: String
  createComponentIfMissing: Boolean
  createComponentName: String
  createComponentVersionSchema: String
  createComponentFeatureBranchVersionSchema: String
  """
  Optional perspective UUID. When supplied with createComponentIfMissing
  and the component does not yet exist, the new component is created and
  assigned to this perspective; authorization with a FREEFORM key requires
  WRITE on the perspective. Ignored when the component already exists.
  """
  perspective: ID
  """
  Optional PR metadata bundled with the call. When supplied on
  addReleaseProgrammatic, a first-class PullRequest entity is upserted
  by (targetVcsRepository, identity) and its head is advanced to the
  release's SCE. The PR aggregator picks up the release on subsequent
  VALIDATE_PR firings. Ignored on calls that do not create a release.
  """
  pullRequest: PullRequestInfoInput
  """
  Opt-in dedup override for the commit-keyed gate on
  (component, branch, commit). When a version_assignment already
  exists for the supplied commit on this branch:
    - rebuild = false (default) → mutation fails with an error so the
      duplicate CI run can fail fast instead of minting a second
      release on the same head.
    - rebuild = true → return the existing version assignment so the
      caller intentionally reuses the same version (e.g. a re-issue
      of an artifact for the same commit).
  No effect when no commit is supplied (manual mints, marketing
  versions, commit-less callers).
  """
  rebuild: Boolean
}

input ReleaseInputProg {
  version: String!
  lifecycle: ReleaseLifecycleEnum
  component: ID
  branch: String
  sourceCodeEntry: SourceCodeEntryInput
  artifacts: [ArtifactInput]
  inboundDeliverables: [DeliverableInput]
  outboundDeliverables: [DeliverableInput]
  endpoint: String
  commits: [SourceCodeEntryInput]
  """
  DEPRECATED -- silently dropped by addReleaseProgrammatic. The resolver
  only consumes source-code-entry artifacts from `sourceCodeEntry.artifacts`
  (or each `commits[i].artifacts` for multi-commit inputs). Nest the
  artifacts there instead. The server logs a WARN whenever this field
  is supplied so we can track remaining callers before removing it.
  """
  sceArts: [ArtifactInput] @deprecated(reason: "Nest SCE artifacts under sourceCodeEntry.artifacts (or commits[i].artifacts); this top-level field is ignored by addReleaseProgrammatic.")
  identifiers: [IdentifierInput]
  gudidRecord: GudidRecordInput
  gudidStatus: GudidStatus
  eos: String
  eol: String
  vcsUri: String
  repoPath: String
  vcsDisplayName: String
  createComponentIfMissing: Boolean
  createComponentName: String
  createComponentVersionSchema: String
  createComponentFeatureBranchVersionSchema: String
  """
  Optional perspective UUID. When supplied together with createComponentIfMissing=true and
  the component does not yet exist, the new component is created and assigned to this
  perspective. Required scope on the API key is WRITE on the perspective (FREEFORM keys)
  or any broader scope that covers it. Ignored when the component already exists.
  """
  perspective: ID
  rebuildRelease: Boolean
  """
  Optional PR metadata bundled with the call. When supplied on
  addReleaseProgrammatic, a first-class PullRequest entity is upserted
  by (targetVcsRepository, identity) and its head is advanced to the
  release's SCE. The PR aggregator picks up the release on subsequent
  VALIDATE_PR firings. Ignored on calls that do not create a release.
  """
  pullRequest: PullRequestInfoInput
}

input AddODeliverableInput {
  release: ID
  component: ID
  variant: ID
  version: String
  deliverables: [DeliverableInput]
}

type Component {
  uuid: ID
  name: String
  org: ID
  resourceGroup: ID
  type: ComponentType
  kind: ComponentKind
  versionSchema: String
  marketingVersionSchema: String
  versionType: VersionType
  vcs: ID
  vcsRepositoryDetails: VcsRepository
  featureBranchVersioning: String
  repositoryEnabled: Int
  status: Status
  apiKeyId: String
  apiKey: String
  createdType: ProgrammaticType
  lastUpdatedBy: ID
  createdDate: DateTime
  defaultConfig: String
  visibilitySetting: VisibilitySetting
  approvalPolicy: ID
  approvalPolicyDetails: ApprovalPolicy
  """
  Resolved approval policy for this component. Per-component
  {@code approvalPolicy} wins when present AND still references an
  existing policy. Otherwise the org-wide rule list is walked in
  order; the first rule whose {@code namePattern} matches the
  component's name AND whose {@code componentType} accepts the
  component's type contributes its policy. {@code source} discriminates
  between the cases; {@code ruleName} is set only when source =
  ORG_RULE; {@code alsoMatchedRuleNames} carries any later-list rules
  whose pattern + type-filter also matched; {@code perComponentPolicyArchived}
  is true when the component carried a per-component reference but
  the referenced policy was archived/missing, so resolution fell
  through to org rules (signals a stale reference for the UI to
  warn about).
  """
  effectiveApprovalPolicy: EffectiveApprovalPolicy
  releaseInputTriggers: [ReleaseInputEvent]
  outputTriggers: [ReleaseOutputEvent]
  identifiers: [Identifier]
  nature: ComponentNature
  deviceClass: DeviceClass
  medicalProfile: MedicalProfile
  repoPath: String
  authentication: ComponentAuthentication
  branchSuffixMode: BranchSuffixMode
  globalInputEventRefs: [GlobalInputEventRef]
  perspectiveDetails: [Perspective]
  """
  Component-level sid override (null = INHERIT).
  """
  sidPurlOverride: SidPurlOverride
  """
  Component-level decoded authority segments (null/empty = none stored).
  """
  sidAuthoritySegments: [String!]
  """
  Internal/external classification (D16). Null on legacy rows is treated as INTERNAL.
  """
  isInternal: BelongsToOrganization
  """
  Synthetic component-level lifecycle derived from the lifecycles of the
  component's releases:
  - if every release lifecycle is ≤ GENERAL_AVAILABILITY, returns the
    most-advanced of those (i.e. max-pre-or-at-GA);
  - otherwise returns the smallest lifecycle ≥ GENERAL_AVAILABILITY
    observed across releases (i.e. min-post-GA).
  Null when the component has no releases.
  """
  effectiveLifecycle: ReleaseLifecycleEnum
  """
  Manually-assigned lead user UUIDs for this component/product.
  """
  leads: [ID!]
  """
  Resolved org-user details for the manually-assigned leads.
  """
  leadDetails: [OrgUserData!]
  """
  Freeform stakeholder contacts for non-registered users (HTML-sanitized on write).
  """
  contacts: [ComponentContact!]
  """
  Derived team: org users holding a READ_WRITE-or-stronger COMPONENT-scoped
  permission on this component. Falls back up the parent (product) chain when
  the component itself has no direct members.
  """
  team: [OrgUserData!]
  """
  Derived approvers: org users whose COMPONENT-scoped permission on this
  component carries one or more approval-role grants. Same parent fallback as team.
  """
  approvers: [OrgUserData!]
  """
  Stored durable owner (team-preferred, USER escape hatch); null = none set (RFC Phase 4).
  """
  owner: ComponentOwner
  """
  Computed ownership resolution: status / durability / derived suggestion. Pure
  recompute (never stored); a non-OWNED status drives a non-blocking banner + the
  at-risk report and NEVER blocks releases.
  """
  ownership: ComponentOwnership!
}

input CreateComponentInput {
  org: ID
  name: String!
  type: ComponentType!
  defaultBranch: String
  versionSchema: String
  marketingVersionSchema: String
  versionType: VersionType
  featureBranchVersioning: String
  vcs: ID
  vcsRepository: VcsRepositoryInput
  includeApi: Boolean
  approvalPolicy: ID
  identifiers: [IdentifierInput]
  nature: ComponentNature
  deviceClass: DeviceClass
  medicalProfile: MedicalProfileInput
  repoPath: String
  branchSuffixMode: BranchSuffixMode
  """
  Component-level sid override. Only writeable when the org is in ENABLED_FLEXIBLE;
  the mutation layer rejects ENABLE/DISABLE writes otherwise (D3).
  """
  sidPurlOverride: SidPurlOverride
  """
  Component-level authority segments. May be set even when sidPurlOverride is INHERIT --
  the segments only take effect once a higher level enables sid for this component.
  """
  sidAuthoritySegments: [String!]
  """
  Whether this component is the tenant's own software (INTERNAL) or a tracked
  third-party dependency (EXTERNAL). Defaults to INTERNAL when null. EXTERNAL
  components never receive a platform-stamped sid PURL (D16).
  """
  isInternal: BelongsToOrganization
}

input AddArtifactInput {
  release: ID
