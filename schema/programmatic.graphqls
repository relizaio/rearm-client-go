enum ViolationType {
  LICENSE
  SECURITY
  OPERATIONAL
}

enum FindingsVerdict {
  PASSED
  REJECTED
}

type TestCounts {
  passed: Int
  failed: Int
  skipped: Int
}

"""
What an index's items are about, and therefore who answers them.
"""
type FindingsAbout {
  specification: SpecificationType
  """
  The release of that input the items refer to, so an answer is recognisable as one.
  """
  release: ID
}

type ArtifactChangelog {
  added: [DiffComponent]
  removed: [DiffComponent]
}

input BoardModelStrengthSpecInput {
  model: String!
  strength: Float!
}

input PartyInput {
  roles: [PartyRole]
  bomRef: String
  priority: Int
  name: String
  address: AddressInput
  contacts: [PartyContactInput]
  url: String
  origin: OriginInput
}

input OriginInput {
  basis: String
  origins: [OriginShareInput]
}

input ExternalRefInput {
  type: String
  url: String
  comment: String
}

enum ApprovalMappingClass {
  RELEASE_LIFECYCLE
  MARKETING_RELEASE_LIFECYCLE
  ENVIRONMENT_TYPE
}

type ApprovalRequirement {
  org: ID
  allowedApprovalRoleIds: [ID]
  allowedApprovalRoleIdExpanded: [ApprovalRole]
  requiredNumberOfApprovals: Int
  permittedNumberOfDisapprovals: Int
}

type UserPermission {
  org: ID
  scope: PermissionScope
  object: ID
  type: PermissionType
  functions: [PermissionFunction]
  meta: String
  approvals: [String]
}

enum PropertyDataType {
  STRING
  JSON
  INTEGER
  YAML
  BOOLEAN
}

enum PropertyTargetType {
  INSTANCE
  COMPONENT
}

"External identity providers whose tokens an organization can trust"
enum FederatedProvider {
  GITHUB_ACTIONS
}

"""
Provider tier a request ran on; the same model bills differently per tier.
"""
enum ServiceTier {
  STANDARD
  BATCH
  PRIORITY
}

"""
Whether a pricing entry applies to requests that used extended thinking. ANY is
not "unset": it deliberately covers both, while an absent field does not
discriminate at all.
"""
enum ReasoningMatch {
  ON
  OFF
  ANY
}

enum ObservedItemStatus {
  MATCHED
  DRIFTED
  FOREIGN_COMPONENT
  UNKNOWN
}

enum PartyRole {
  MANUFACTURER
  ASSEMBLER
  SUPPLIER
  QUALITY_CONTROL
  DISTRIBUTOR
  OTHER
}

type Address {
  streetAddress: String
  city: String
  region: String
  postalCode: String
  country: String
  isoCode: String
  coords: Coords
}

type PartyContact {
  name: String
  email: String
  phone: String
}

type OriginShare {
  originCode: String
  percentage: Float
}

enum VulnerabilityAliasType {
  CVE
  GHSA
  GO
  PYSEC
  RUST
  OSV
  DSA
  DLA
  RHSA
  RHBA
  RHEA
  ALAS
  ALAS2
  ALPINE
  CGA
  MAL
  GSD
  OTHER
}

enum SeveritySource {
  NVD
  GHSA
  ANALYSIS
  OTHER
}

type DiffComponent {
  purl: String
  version: String
}

input AddressInput {
  streetAddress: String
  city: String
  region: String
  postalCode: String
  country: String
  isoCode: String
  coords: CoordsInput
}

input PartyContactInput {
  name: String
  email: String
  phone: String
}

input OriginShareInput {
  originCode: String
  percentage: Float
}

enum PermissionScope {
  ORGANIZATION
  INSTANCE
  PERSPECTIVE
  COMPONENT
  BRANCH
  RELEASE
}

enum PermissionType {
  ADMIN
  READ_ONLY
  READ_WRITE
  ESSENTIAL_READ
  NONE
}

enum PermissionFunction {
  RESOURCE
  FINDING_ANALYSIS_READ
  FINDING_ANALYSIS_WRITE
  ARTIFACT_DOWNLOAD
  SBOM_PROBING
  LIFECYCLE_UPDATE
  DEVOPS_READ
  DEVOPS_WRITE
  VERSION_FEATURESET
  AGENT
  DISTRIBUTION
  """
  Export declarative configuration (Catalog, Branches) through the programmatic API.
  """
  CONFIGURATION_READ
  """
  Apply declarative configuration through the programmatic API; implies CONFIGURATION_READ.
  """
  CONFIGURATION_WRITE
}

type Coords {
  latitude: Float
  longitude: Float
}

input CoordsInput {
  latitude: Float
  longitude: Float
}

