  detail: String
  attemptedAt: DateTime
  fingerprint: String
}

type Instance {
  uuid: ID
  uri: String
  org: ID
  name: String
  displayName: String
  namespace: String
  instanceType: InstanceType
  status: Status
  notes: String
  spawnType: SpawnType
  instances: [ID]
  environment: String
  properties: [InstancePropertyRecord]
  releases: [DeployedRelease]
  targetReleases: [DeployedRelease]
  unmatchedReleases: [UnmatchedImage]
  deploymentFailures: [InstanceDeploymentFailure]
  deploymentHealth: DeploymentHealth
  agentData: String
  productPlans: [InstanceProductMapPlan]
  productActuals: [InstanceProductMapActual]
  createdType: ProgrammaticType
