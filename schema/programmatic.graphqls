  notes: String
  endpoint: String
  tags: [TagRecord]
}

type ReleaseUpdateEvent {
  rus: ReleaseUpdateScopeEnum
  rua: ReleaseUpdateActionEnum
  oldValue: String
  newValue: String
  objectId: ID
  """
  Human-readable reason for this event, populated when the
  change carries context the oldValue/newValue tuple cannot
  convey on its own. For LIFECYCLE events fired by a
  component-level CEL input trigger, this carries the trigger
  name and the CEL expression that matched. null for events
  whose meaning is fully captured by the structural fields.
  """
  message: String
  date: DateTime
  wu: WhoUpdated
}

type DependencyTrackMetrics {
  dependencyTrackFullUri: String
  dtrackSubmissionFailed: Boolean
  dtrackSubmissionAttempts: Int
  dtrackSubmissionFailureReason: String
  dtrackFetchStatus: String
  dtrackFetchFailureCount: Int
  dtrackFetchFailureReason: String
  dtrackFetchSkipUntil: String
  lastScanned: DateTime
  firstScanned: DateTime
  critical: Int
  high: Int
  medium: Int
  low: Int
  unassigned: Int
  vulnerabilities: Int
  vulnerableComponents: Int
  components: Int
  suppressed: Int
  findingsTotal: Int
  findingsAudited: Int
  findingsUnaudited: Int
  inheritedRiskScore: Int
  policyViolationsFail: Int
  policyViolationsWarn: Int
  policyViolationsInfo: Int
  policyViolationsTotal: Int
  policyViolationsAudited: Int
  policyViolationsUnaudited: Int
  policyViolationsSecurityTotal: Int
  policyViolationsSecurityAudited: Int
  policyViolationsSecurityUnaudited: Int
  policyViolationsLicenseTotal: Int
  policyViolationsLicenseAudited: Int
  policyViolationsLicenseUnaudited: Int
  policyViolationsOperationalTotal: Int
  policyViolationsOperationalAudited: Int
  policyViolationsOperationalUnaudited: Int
  vulnerabilityDetails: [Vulnerability]
  violationDetails: [Violation]
  weaknessDetails: [Weakness]
}

type Identifier {
  idType: IdentifierType
  idValue: String
}

"""
Pointer from a release to document bytes in a repository, present only on
releases of specification components. The commit and repository are NOT
repeated here: they come from the release's source code entry, so the
recognised-commit predicate and signature verification apply to a document
exactly as they do to code.
"""
type DocumentRef {
  specification: SpecificationType
  """
  Repo-relative path at the release's commit.
  """
  path: String
  digest: String
  mediaType: String
  indexPath: String
  indexDigest: String
  """
  The task this round belongs to, for TASK-scoped types.
  """
  task: ID
  """
  The session that published it.
  """
  session: ID
  """
  1-based count of this task's rounds of this type.
  """
  round: Int
  """
  The findings index for REVIEW_FINDINGS and TEST_REPORT; absent otherwise.
  """
  findings: FindingsIndex
}

"""
Version-specific GUDID record for a UDI-bearing release.
"""
type GudidRecord {
  brandName: String
  versionModel: String
  gmdnCode: String
  sterile: Boolean
  singleUse: Boolean
  mriSafety: Boolean
}

"""
GUDID submission workflow state for a UDI-bearing release.
"""
enum GudidStatus {
  NOT_SUBMITTED
  SUBMITTED
  PUBLISHED
}

type ReleaseCollection {
  uuid: ID
  artifactComparison: ArtifactComparison
}

type IntermediateFailedRelease {
  releaseUuid: ID!
  releaseVersion: String!
  releaseLifecycle: ReleaseLifecycleEnum!
  releaseCreatedDate: DateTime
  commits: [SourceCodeEntry]
}

enum SbomProbingStatus {
  PENDING
  ENRICHING
  DONE
  FAILED
}

input TagRecordInput {
  key: String
  value: String
}

input ConditionGroupOnGetLatestReleaseInput {
  matchOperator: MatchOperator
  conditions: [ConditionOnGetLatestReleaseInput]
}

type KeyValue {
  key: String
  value: String
  lastUpdated: Int
}

type NamedRef {
  uuid: ID!
  name: String!
}

enum IntegrateType {
  FOLLOW
  INTEGRATE
  UNINSTALL
  TARGET
  NONE
}

type FeatureSetReleaseRef {
  uuid: ID!
  version: String!
  lifecycle: String
  createdDate: DateTime
  """
  True when the release carries an approval for the instance plan's environment (or the plan has
  no environment, in which case FOLLOW takes the newest release regardless).
  """
  approvedForInstanceEnvironment: Boolean!
}

"""
A feature set the caller could switch a deployment to, with the releases it could target.
"""
type FeatureSetOption {
  uuid: ID!
  name: String!
  """
  Newest first, ASSEMBLED or later lifecycles only, capped server-side. Any of these is a valid
  value for switchInstanceProductFeatureSet.release.
  """
  releases: [FeatureSetReleaseRef!]!
}

enum AgentInboxEventKind {
  """
  A release's lifecycle moved (e.g. ASSEMBLED → REJECTED, PENDING → ASSEMBLED).
  """
  LIFECYCLE_CHANGE
  """
  An approval entry on a release flipped (APPROVED / DISAPPROVED / withdrawn).
  """
  APPROVAL
  """
  A new PolicyEvent landed on the session itself (post-init artifact-attach / commit-attribution re-eval).
  """
  POLICY_VERDICT
}

enum AgentInboxSource {
  """
  A human user performed the action (approval, manual lifecycle change).
  """
  HUMAN
  """
  An automated component-level output trigger fired (CEL gate matched).
  """
  POLICY_GATE
  """
  Lifecycle progressed by the system without an explicit trigger (e.g. initial release-created PENDING).
  """
  RELEASE_AUTO
}

enum SessionStatus {
  OPEN
  CLOSED
  """
  A BLOCK-severity INPUT policy failed on sessionInitializeProgrammatic.
  The row is persisted so the audit / dashboard show the rejected
  attempt with its policyEvents, but the trailer-attribution
  resolver refuses to bind commits against it -- trailers carrying
  this clientSessionId surface as REJECTED attribution. Terminal:
  the agent must mint a fresh, unique clientSessionId to retry.
  """
  BLOCKED
}

"""
Rollup of usage rows. Tokens are facts and never change; cost is derived from a
dated price entry, so every rollup names the entries it used.
"""
type UsageTotals {
  inputTokens: Long
  outputTokens: Long
  cacheReadTokens: Long
  cacheWriteTokens: Long
  requests: Int
  turns: Int
  toolCalls: Int
  wallSeconds: Int
  """
  Number of report lines rolled up here.
  """
  reports: Int
  byModel: [UsageByModel]
  derivedCostMicros: Long
  priceVersions: [ID]
  """
  False when some row had no applicable price: the cost is a lower bound.
  """
  costComplete: Boolean
}

"""
How much of a session's consumption we believe we have. INCOMPLETE means the
scheduler or an operator ended the session, so the tail is missing; NONE means
nothing ever reported. A cheap session and an unreported one are not the same claim.
"""
enum SessionUsageCompleteness {
  COMPLETE
  INCOMPLETE
  NONE
}

"""
A single agent-policy evaluation outcome on a session. SAAS-only --
on CE deployments the session's {@code policyEvents} list is always
empty. Persisted append-only on AgentSession.
"""
type PolicyEvent {
  """
  UUID of the AgentPolicy that produced this verdict.
  """
  policyUuid: ID
  """
  Snapshot of the policy's name at evaluation time (denormalised so a renamed/deleted policy still surfaces sensibly).
  """
  policyName: String
  kind: PolicyKind
  severity: PolicySeverity
  state: PolicyState
  """
  Operator-facing failure message; null on PASSED verdicts.
  """
  message: String
  evaluatedAt: DateTime
  """
  Full snapshot of the AgentPolicy that produced this verdict (CEL,
  description, current enabled flag). Lets a calling agent decide
  whether the failure is recoverable on its own (e.g. attach an
  orientation artifact and retry) or needs operator action (e.g.
  a "model must equal claude-opus" policy when the agent runs
  another model). Resolved at read time from the policyUuid; null
  if the policy was deleted after the event.
  """
  policy: AgentPolicy
}

"""
How much trust a session's recorded model carries -- see
Session.modelAssertion.
"""
enum ModelAssertionState {
  """
  Agent self-reported the model string via the CLI; trusted but unverified.
  """
  DECLARED
  """
  Model read from the runtime's own record (e.g. Claude Code transcript). Reserved for Path-B hooks; not yet emitted.
  """
  RUNTIME_OBSERVED
}

"""
One agent-tool session a ReARM session ran in. See Session.providerSessions.
"""
type ProviderSession {
  """
  The tool, as the reporting client names it ("claude-code").
  """
  provider: String!
  """
  The tool's local id for the session -- for Claude Code, its transcript id.
  """
  id: String!
  """
  The id a hosted surface of the tool knows the session by; null for a purely local run.
  """
  remoteId: String
  """
  When ReARM first heard of this pairing.
  """
  reportedAt: DateTime
}

"""
See Session.origin.
"""
type SessionOrigin {
  authMethod: SessionAuthMethod
  """
  The CLI login the session was opened through, when authMethod is CLI_LOGIN.
  """
  cliSession: ID
  """
  The person the session is attributed to, or null when nothing names one -- an organisation
  key, a federated identity, or a Free Form key with no holder.
  """
  ownerUser: ID
  ownerSource: SessionOwnerSource
  """
  What the CLI login recorded about its device when it was approved.
  """
  loginDevice: SessionDevice
  """
  What the client said about its device when it opened the session.
  """
  reportedDevice: SessionDevice
  """
  The client address the server saw when the session was opened. Restricted.
  """
  observedIp: String
  """
  The external identity, when authMethod is FEDERATED.
  """
  federation: SessionFederation
  capturedAt: DateTime
  """
  True when this reader is not allowed the personal fields, which then read null. Lets a UI
  tell "hidden from you" from "never reported".
  """
  restricted: Boolean!
}

enum AgentBoardStatus {
  ACTIVE
  ARCHIVED
}

"""
Well-known specification documents. When an identifier's idType is SPECIFICATION its idValue is
one of these values -- the design-stage counterpart of TEA's compliance-document-type, so a
document set is discoverable by identifier rather than by naming convention.
"""
enum SpecificationType {
  CONOPS
  USE_CASES
  REQUIREMENTS
  FUNCTIONS
  PRODUCT_BREAKDOWN
  INTERFACES
  DATA_MODEL
  ARCHITECTURE
  DETAILED_DESIGN
  UX_CONCEPT
  TEST_PLAN
  GLOSSARY
  DECISION_RECORD
  """
  One review round of one task. Task-scoped: one component per board target holds every task's rounds.
  """
  REVIEW_FINDINGS
  """
  One test run of one task. Task-scoped, like REVIEW_FINDINGS.
  """
  TEST_REPORT
  """
  What one hop could not proceed without knowing. Task-scoped, like REVIEW_FINDINGS, and
  usually published with no file at all -- the items are the document.
  """
  QUESTIONS
}

type AgentBoardEvent {
  kind: AgentBoardEventKind
  message: String
  actor: AgentActor
  eventAt: DateTime
}

type AgentBoardLock {
  level: AgentBoardLockLevel
  reason: String
  lockedBy: AgentActor
  lockedAt: DateTime
}

"""
Singleton coordinator seat: one session per board, held until that session closes.
"""
type AgentCoordinatorSeat {
  session: ID
  agent: ID
  claimedAt: DateTime
}

scalar Long

type DeclarativeProvenance {
  """
  SHA-256 of the canonical JSON of the spec that last touched this row.
  """
  specHash: String
  appliedAt: DateTime
  source: DeclarativeSource
}

type AgentTaskSnapshot {
  task: AgentTask
  """
  Who holds it now, or null when nobody does.
  """
  holder: AgentActor
  heldSince: DateTime
  """
  What it waits on, with each dependency's own status.
  """
  dependsOn: [AgentTaskDependency]
  """
  Newest release per specification type, so a reader sees the current document set.
  """
  latestDocuments: [Release]
  """
  Top of the question stack. Null when nothing is outstanding.
  """
  waitingOn: AgentQuestionFrame
  """
  What the task has spent, in USD micros, as the budget counts it: the derived
  cost of every usage row attributed to it, whenever it was reported, plus its
  apportioned coordinator estimate. Rows without a price count 0.
  """
  spentMicros: Long
  budgetMicros: Long
}

"""
What a requirement resolved to when the task was assigned, pinned on the assignment: the version
the agent works from, and the trail from a later rejection back to the work that consumed it.
"""
type AgentResolvedInput {
  kind: AgentInputKind
  specification: SpecificationType
  component: ID
  release: ID
  version: String
  lifecycle: ReleaseLifecycleEnum
}

"""
A completed task sent back to a role.
"""
type AgentTaskReopen {
  role: String
  roleUuid: ID
  at: DateTime
  by: AgentActor
  reason: String
}

"""
Who did something on a board: the identity on a lock, an event, a hold or a human sign-off.

These were all String, and every writer invented its own encoding -- a session uuid behind a
"coordinator-session:" prefix, a user's email, the bare literal "operator". Reading one meant
knowing the convention and splitting on a colon. kind says which identity space uuid belongs
to; name is what a human should read. Rows written before this are decoded on read, so an
older lock still resolves.
"""
type AgentActor {
  kind: AgentActorKind
  """
  The session or user uuid, when the writer knew it. Null on older rows and on SYSTEM.
  """
  uuid: ID
  """
  Display text: an email for a user, a detail such as "humanGate" for SYSTEM.
  """
  name: String
}

"""
One unanswered question: who asked, about what, and who is expected to answer.

Questions nest -- a tester asks the coder, who cannot answer without asking the architect -- so
each answer pops one frame and the chain unwinds to whoever started it.
"""
type AgentQuestionFrame {
  askingRole: ID
  askingSession: ID
  askingAgent: ID
  """
  The index release carrying the items.
  """
  questionsRelease: ID
  """
  The role that produces the questioned input; null while the coordinator is deciding who that is.
  """
  answeringRole: ID
  askedAt: DateTime
}

type AgentTaskHold {
  level: AgentTaskHoldLevel
  kind: AgentTaskHoldKind
  """
  Role whose sign-off is under review; set when kind = HUMAN_GATE.
  """
  gateRole: String
  reason: String
  heldBy: AgentActor
  heldAt: DateTime
}

"""
The single live assignment -- bound to session liveness, released on any session close.
"""
type AgentTaskWorkAssignment {
  session: ID
  agent: ID
  role: String
  """
  The role config row `role` named when this assignment was made. Null on assignments made before this field existed.
  """
  roleUuid: ID
  assignedAt: DateTime
  promptVersion: String
  """
  Versions this assignment is bound to work from.
  """
  resolvedInputs: [AgentResolvedInput]
}

"""
Append-only per-hop sign-off stored in ReARM; promptVersion pins the served prompt the agent assumed.
"""
type AgentTaskSignOff {
  role: String
  """
  The role config row `role` named at the time. Null on hops recorded before this field existed.
  """
  roleUuid: ID
  agent: ID
  session: ID
  assignedAt: DateTime
  signedOffAt: DateTime
  outcome: AgentSignOffOutcome
  note: String
  promptVersion: String
  """
  Reviewer identity of a HUMAN sign-off (human role stage or gate verdict); null on agent sign-offs. Non-null reviewedBy IS the human marker.
  """
  reviewedBy: AgentActor
  """
  What this hop consumed, snapshotted when the hop closed. Null on hops that predate usage reporting or whose session never reported.
  """
  usage: HopUsage
  """
  Document releases this hop published, in publish order. Recorded on the hop rather
  than only on the task because a later round's reader needs to know WHICH hop produced
  a document to carry its open findings forward.
  """
  outputs: [ID]
  """
  How far this hop went over its allowance: null when the allowance or the cost is unknown, 0 within it.
  """
  overAllowanceMicros: Long
}

type AgentTaskReturn {
  role: String
  """
  The role config row `role` named at the time. Null on hops recorded before this field existed.
  """
  roleUuid: ID
  agent: ID
  session: ID
  reason: AgentTaskReturnReason
  description: String
  returnedAt: DateTime
  """
  What this hop consumed before it was handed back. A returned hop still costs money.
  """
  usage: HopUsage
  """
  Document releases published before the hop was handed back; a returned hop can still have produced one.
  """
  outputs: [ID]
  """
  How far this hop went over its allowance: null when the allowance or the cost is unknown, 0 within it.
  """
  overAllowanceMicros: Long
}

"""
One status transition, written atomically with the transition. Intervals between rows are the
cycle-time metrics (notably AWAITING_COORDINATOR -> QUEUED = coordinator routing latency).

actor is who caused it: the worker or coordinator session, the human who approved at a gate, or
the system on a sweep. It was a bare session uuid, so every human-caused transition recorded
null -- "who moved this task" had no answer for exactly the moves a person made.
"""
type AgentTaskStatusChange {
  from: AgentTaskStatus
  to: AgentTaskStatus
  at: DateTime
  trigger: AgentStatusTrigger
  actor: AgentActor
  """
  What the actor said: a completion's or cancellation's note. Null on changes recorded before notes were kept.
  """
  note: String
}

type AgentRequiredInput {
  kind: AgentInputKind
  """
  DOCUMENT only: which specification document, resolved against the board's target node.
  """
  specification: SpecificationType
  """
  RELEASE only.
  """
  scope: AgentInputScope
  """
  RELEASE with COMPONENT scope: null means the board's target node.
  """
  component: ID
  minLifecycle: ReleaseLifecycleEnum
  """
  Null falls back to the board's defaultInputResolution.
  """
  resolution: AgentInputResolution
}

"""
One hop's consumption, frozen when the hop ended.
"""
type HopUsage {
  inputTokens: Long
  outputTokens: Long
  cacheReadTokens: Long
  cacheWriteTokens: Long
  requests: Int
  turns: Int
  reports: Int
  derivedCostMicros: Long
  priceVersions: [ID]
  costComplete: Boolean
  """
  The role's allowance when the hop ended; null when it set none, and on hops recorded before allowances were kept.
  """
  allowanceMicros: Long
}

type Finding {
  """
  Stable within a task across rounds: an open finding is carried forward under the same id.
  """
  id: String
  """
  1 highest, at most the organization's level count.
  """
  priority: Int
  status: FindingStatus
  """
  One line; the reasoning is in the markdown under a heading carrying the id.
  """
  title: String
  location: FindingLocation
  """
  The uuid of the release whose round closed it -- a pointer, never text. Null while the item is
  open. A round that closes an item names itself here, unless another release already answers
  for it: when an upstream role answered by republishing its document, this points at that
  document rather than at the round recording the closure.
  """
  resolvedBy: String
  """
  The words that closed it: a fixer's note, a policy stop's reason, or the answer to a question.
  """
  resolution: String
  """
  Who last decided this finding -- accepted, dismissed or re-prioritised it, or filed it by hand --
  a person or the agent session whose round did. Written by the server, never by an agent. Null
  when nobody has decided it: an agent's finding as filed, or a decision made before this was kept.
  """
  decidedBy: AgentActor
  """
  The release of the round that made that decision.
  """
  decidedIn: ID
  """
  When that decision was made: the creation time of decidedIn's release. Computed per read.
  """
  decidedAt: DateTime
}

"""
The kinds of work a model's strength can differ by. A board role maps to one of these through
AgentTaskRoleConfig.strengthCategory.
"""
enum ModelRoleCategory {
  ARCHITECT
  CODER
  QA
  REVIEWER
}

"""
A role's strength override for one model.
"""
type RoleModelStrength {
  model: ID!
  strength: Float!
}

"""
Who works this role. AGENTIC: agents poll/assume/sign off through sessions. HUMAN: a deliberate human workflow stage -- never offered to agent polls; an org admin signs off directly from the queue.
"""
enum AgentRoleKind {
  AGENTIC
  HUMAN
}

"""
Whether the coordinator may skip this role. REQUIRED: a task cannot be COMPLETED unless its most recent sign-off in this role is PASSED (cancel and split parents with completed children exempt).
"""
enum AgentRoleNecessity {
  OPTIONAL
  REQUIRED
}

"""
Conditional human review of this role's sign-offs. Fires only when the role actually signs off. ON_PASS: PASSED sign-offs park ON_HOLD for a human verdict; ON_ANY_SIGNOFF: rejections gate too.
"""
enum AgentHumanGate {
  NONE
  ON_PASS
  ON_ANY_SIGNOFF
}

"""
A document a role is expected to publish during its hop.
"""
type AgentProducedOutput {
  specification: SpecificationType
  scope: AgentInputScope
  """
  False makes it advisory, for roles that sometimes have nothing to write.
  """
  required: Boolean
}

type DeclarativeChange {
  """
  Slice the entry belongs to: CATALOG entries are components, BRANCHES entries are branches.
  """
  kind: DeclarativeKind!
  name: String!
  action: DeclarativeAction!
  """
  Fields that differ (UPDATE) or would be set (CREATE).
  """
  fields: [String!]
  message: String
  """
  What the change leaves for someone to deal with, e.g. tasks waiting on a role the file deactivates. Never a refusal.
  """
  warnings: [String!]
}

input CatalogComponentInput {
  name: String!
  type: ComponentType!
  kind: ComponentKind
  versionSchema: String
  marketingVersionSchema: String
  versionType: VersionType
  featureBranchVersioning: String
  """
  Base branch name on create only (main by default).
  """
  defaultBranch: String
  """
  VCS repository by URI; created in the org when missing.
  """
  vcsUri: String
  vcsType: String
  repoPath: String
  nature: ComponentNature
  deviceClass: DeviceClass
  branchSuffixMode: BranchSuffixMode
  identifiers: [IdentifierInput!]
}

input BranchSpecInput {
  name: String!
  type: BranchType
  versionSchema: String
  marketingVersionSchema: String
  vcsBranch: String
  autoIntegrate: AutoIntegrateState
  findingAnalyticsParticipation: FindingAnalyticsParticipation
  dependencies: [DependencySpecInput!]
  dependencyPatterns: [DependencyPatternSpecInput!]
}

input BoardSettingsSpecInput {
  budgetMicros: Long
  softAlertPercent: Int
  cycleCap: Int
  noProgressRepeatsToStop: Int
  blockingPriority: Int
  completionPriority: Int
}

"""
One role, or one preset: always complete on the wire -- a file's file: and promptFile: are inlined by the client.
"""
input BoardRoleSpecInput {
  name: String!
  prompt: String
  """
  Absent on a new role: ten times its position in the list. Absent on an existing role: unchanged.
  """
  orderIndex: Int
  wipLimit: Int
  requireDistinctAgent: Boolean
  """
  Absent: true -- declaring a role is what reactivates it.
  """
  active: Boolean
  kind: AgentRoleKind
  necessity: AgentRoleNecessity
  humanGate: AgentHumanGate
  requiredCapabilities: [AgentCapability!]
  requiredInputs: [BoardRequiredInputSpecInput!]
  producesOutputs: [BoardProducedOutputSpecInput!]
  """
  Allowance for one assignment of this role, in USD micros: the projection's estimate when the board has no history for the role, told to the worker at assignment, and flagged on the hop and the board when a hop exceeds it. Not enforced mid-hop -- agents pull, and the server learns the cost when it is reported.
  """
  hopBudgetMicros: Long
  strength: BoardStrengthSpecInput
}

type PullRequestValidationEvent {
  date: DateTime
  validationState: ValidationState
  comment: String
  sourceCodeEntry: ID
  attributedReleases: [ID]
}

type ReleaseValidationEvent {
  release: ID
  date: DateTime
  validationResult: ValidationState
}

enum ValidationState {
  SUCCESS
  FAILURE
  NEUTRAL
  SKIPPED
  CANCELLED
  """
  Internal "verdict not yet computable" state -- recorded on
  pr_validation_events when at least one release attributed to the
  PR has no validation event yet. Never dispatched to the SCM
  (GitHub doesn't have a matching check-run conclusion); the prior
  terminal verdict's check-run stays in place until a new terminal
  verdict supersedes it.
  """
  PENDING
}

input SourceCodeEntryInput {
  branch: ID
  vcs: ID
  organizationUuid: ID
  uri: String
  type: String
  commit: String
  commits: [String]
  commitMessage: String
  commitAuthor: String
  commitEmail: String
  vcsTag: String
  dateActual: String
  vcsBranch: String
  notes: String
  artifacts: [ArtifactInput]
}

"""
PR metadata supplied by CI alongside an addReleaseProgrammatic call.
The caller (rearm-actions or any CI integration) populates these fields
from the SCM event context. Identity is opaque string ((targetVcs,
identity) is the uniqueness boundary) -- supports GitHub PR numbers as
strings, GitLab MR iids, and Gerrit change-IDs uniformly.
"""
input PullRequestInfoInput {
  """
  SCM-side PR / MR / change-list identity (e.g. GitHub PR number "42",
  GitLab MR iid "42", Gerrit change-id). Required.
  """
  identity: String!
  """
  "OPEN", "CLOSED", or "MERGED". Case-insensitive -- converted to
  PullRequestState server-side.
  """
  state: String!
  title: String
  sourceBranchName: String
  targetBranchName: String
  """
  Link back to the PR in the upstream SCM (e.g., GitHub PR URL).
  """
  endpoint: String
}

enum AttestationType {
  COMMIT_ACKNOWLEDGEMENT
  LOCK_RELEASE
}

enum AttestationSubjectType {
  SCE
  RELEASE
  LOCK
}

"""
What the subject was called when the statement was made; display only.
"""
type AttestationSubjectRef {
  component: ID
  componentName: String
  commit: String
  version: String
}

enum AttestationActorType {
  USER
  AGENT
}

enum AttestationRecordStatus {
  ACTIVE
  REVOKED
}

enum LockScope {
  COMPONENT
  BRANCH
}

enum LockStatus {
  ACTIVE
  RELEASED
}

enum LockOrigin {
  MANUAL
  POLICY
}

"""
One thing a lock is waiting on.
"""
type LockCause {
  subjectType: LockSubjectType
  subjectUuid: ID
  """
  Human text carried into the refusal, e.g. "commit a1b2c3d: unsigned, no attribution".
  """
  detail: String
}

"""
Who may release a lock.
"""
enum UnlockLevel {
  """
  Any recognized principal, agent or user, through either API.
  """
  AGENT
  """
  A user; an agent cannot.
  """
  HUMAN
  """
  A component or organization administrator.
  """
  ADMIN
}

"""
What must be true of a lock's causes before it may be released.
"""
enum AttestationRequirement {
  """
  Nothing; the level alone decides.
  """
  NONE
  """
  Every cause carries an active MINE attestation from any recognized principal.
  """
  ANY
  """
  Every cause carries an active MINE attestation filed by a user.
  """
  HUMAN
}

input ArtifactInput {
  type: ArtifactType
  displayIdentifier: String
  downloadLinks: [LinkInput]
  inventoryTypes: [InventoryType]
  bomFormat: String
  storedIn: String
  tags: [TagRecordInput]
  status: String
  version: String
  file: Upload
  fileSce: Upload
  stripBom: StripBomEnum
  digestRecords: [DigestRecordInput]
  artifacts: [ArtifactInput]
  vexScope: AnalysisScope
  vexImportMode: VexImportMode
  userIssuerClassOverride: IssuerClass
}

input DeliverableInput {
  displayIdentifier: String
  branch: ID
  type: CdxType
  notes: String
  tags: [TagRecordInput]
  version: String
  publisher: String
  group: String
  supportedOs: [OSEnum]
  supportedCpuArchitectures: [CPUArchitectureEnum]
  softwareMetadata: SoftwareMetadataInput
  hardwareMetadata: HardwareMetadataInput
  quantity: Int
  artifacts: [ArtifactInput]
  identifiers: [IdentifierInput]
}

input IdentifierInput {
  idType: IdentifierType
  idValue: String
}

input GudidRecordInput {
  brandName: String
  versionModel: String
  gmdnCode: String
  sterile: Boolean
  singleUse: Boolean
  mriSafety: Boolean
}

enum ComponentType {
  COMPONENT
  PRODUCT
  ANY
}

enum ComponentKind {
  HELM
  GENERIC
}

enum VersionType {
  DEV
  MARKETING
}

enum VisibilitySetting {
  PUBLIC
  ORG_INTERNAL
  ADMIN_INVITATION
}

type ApprovalPolicy {
  uuid: String
  org: String
  policyName: String
  resourceGroup: String
  approvalMappings: [ApprovalMapping]
  approvalEntries: [ID]
  approvalEntryDetails: [ApprovalEntry]
  status: Status
  globalInputEvents: [ReleaseInputEvent]
  globalOutputEvents: [ReleaseOutputEvent]
}

"""
Resolved approval policy snapshot for a Component. See
{@link Component.effectiveApprovalPolicy}.
"""
type EffectiveApprovalPolicy {
  source: ApprovalPolicySource
  approvalPolicy: ID
  approvalPolicyDetails: ApprovalPolicy
  ruleName: String
  alsoMatchedRuleNames: [String]
  perComponentPolicyArchived: Boolean
}

type ReleaseInputEvent {
  uuid: ID
  name: String
  """
  Output events fired when {@link #celExpression} evaluates to TRUE.
  """
  outputEvents: [ID]
  """
  Output events fired when {@link #celExpression} evaluates to FALSE.
  Optional -- leaving this empty preserves the legacy single-branch
  behavior (rule does nothing when CEL is false). When set, this gives
  operators a way to express "if X then A else B" in one rule instead
  of two competing rules. Both branches are skipped together when the
  rule is disabled or when the component opts out via its
  GlobalInputEventRef.
  """
  outputEventsOnFalse: [ID]
  scope: EventScope
  celExpression: String
  """
  Rule-level enable/disable. Defaults true. When false, the rule is
  skipped at evaluation time for every release that resolves against
  the owning approval policy, overriding any per-component
  GlobalInputEventRef.disabled state. Applies identically to component-
  local rules under Component.releaseInputTriggers.
  """
  enabled: Boolean
  """
  Optional rule-level precondition CEL. When non-empty, evaluated
  BEFORE {@link #celExpression}; if the precondition returns false
  (or throws), the rule is skipped entirely (neither matched- nor
  else-branch actions fire) and the PR conditions snapshot renders
  PENDING. Lets operators express "is this rule applicable yet?"
  separately from "did the condition match?". Necessary for rules
  with {@link #outputEventsOnFalse} populated because the false
  branch would otherwise fire on releases with missing data --
  canonical example: gate metrics-based rules on
  {@code release.firstScanned == true}.
  """
  preconditionCelExpression: String
}

type ReleaseOutputEvent {
  uuid: ID
  name: String
  type: EventType
  toReleaseLifecycle: ReleaseLifecycleEnum
  integration: ID
  users: [ID]
  notificationMessage: String
  vcs: ID
  eventType: String
  clientPayload: String
  celClientPayload: String
  schedule: String
  scope: EventScope
  includeSuppressed: Boolean
  snapshotApprovalEntry: ID
  snapshotLifecycle: ReleaseLifecycleEnum
  approvedEnvironment: String
  """
  Override the check-run name reported to the SCM for EXTERNAL_VALIDATION
  events. Defaults to `rearm/<componentName>` when null/empty. Set this
  when an org-wide branch-protection rule needs a single unified
  required-check entry (GitHub matches by exact string -- no wildcards).
  """
  checkName: String
  """
  LOCK: the branch this release is on, or the whole component. Defaults to BRANCH.
  """
  lockScope: LockScope
  """
  LOCK: who may release the lock this raises. Defaults to HUMAN.
  """
  lockUnlockLevel: UnlockLevel
  """
  LOCK: what must be claimed before the lock may be released. Defaults to ANY.
  """
  lockAttestationRequirement: AttestationRequirement
  """
  LOCK: shown verbatim in every refusal, so it is written for whoever hits it.
  """
  lockReason: String
}

"""
Physical-ness axis of a component (Distribution module).
"""
enum ComponentNature {
  SOFTWARE
  HARDWARE
}

"""
Regulatory classification of a component / device (Distribution module).
"""
enum DeviceClass {
  NONE
  MEDICAL_UNTRACKED
  MEDICAL_TRACKED
}

"""
Regulatory metadata for a medical-device component.
"""
type MedicalProfile {
  issuingAgency: IssuingAgency
  udiBearing: Boolean
  gudidDefaults: GudidDefaults
  """
  The section 524B device support window declared for this device model (decision D7).
  
Null means NOT DECLARED, which is a fact in its own right rather than an unknown to
  fill in. This is the DEVICE window; it is not Release.eos/eol, which are release
  lifecycle for TEA/CLE and are unrelated to a support commitment.
  """
  deviceSupportWindow: DeviceSupportWindow
}

"""
Controls whether non-base branches append a branch-derived suffix to
semver, four-part, and calver versions.
- APPEND: append branch namespace (e.g., 1.2.3-feat_x)
- NO_APPEND: do not append; conflicts resolved via -0, -1, ... suffix
- APPEND_EXCEPT_FOLLOW_VERSION: append for all branches and feature sets,
  except those with at least one follow-version dependency (treated as NO_APPEND for such branches)
- INHERIT: component-level only; defer to organization setting. Not valid at organization level.
"""
enum BranchSuffixMode {
  APPEND
  NO_APPEND
  APPEND_EXCEPT_FOLLOW_VERSION
  INHERIT
}

type GlobalInputEventRef {
  uuid: ID
  """
  Opt-out flag -- under the opt-out semantics introduced May 2026, every
  policy rule fires for every component using the policy unless the
  component has a ref with disabled=true. See ComponentData.GlobalInputEventRef.
  """
  disabled: Boolean
  overrideOutputEventsLocally: Boolean
  outputEventsOverride: [ID]
}

type Perspective {
  uuid: ID
  org: ID
  name: String
  createdDate: DateTime
  type: PerspectiveType
  """
  Perspective-level sid override (SaaS only, real perspectives only). Null/INHERIT
  defers to the org. Only writeable when the org is in ENABLED_FLEXIBLE.
  """
  sidPurlOverride: SidPurlOverride
  """
  Perspective-level decoded authority segments (SaaS only).
  """
  sidAuthoritySegments: [String!]
  """
  Guards applying to every component of this perspective.
  """
  actionGuards: [ActionGuard!]
}

"""
Component- and perspective-level sid override. Only honored when the org is in
ENABLED_FLEXIBLE; the mutation layer rejects ENABLE/DISABLE writes when the org
is STRICT or DISABLED. INHERIT (and null) defer to the next level up.
"""
enum SidPurlOverride {
  INHERIT
  ENABLE
  DISABLE
}

"""
Internal/external classification of a component (D16). EXTERNAL components are
third-party dependencies tracked inside the tenant's org and never receive a
platform-stamped sid PURL -- stamping the tenant's authority on third-party
software would be a falsified vendor claim. Defaults to INTERNAL on create.
"""
enum BelongsToOrganization {
  INTERNAL
  EXTERNAL
}

type OrgUserData {
  uuid: ID
  name: String
  email: String
  githubId: String
  permissions: Permissions
  combinedUserOrgPermissions: Permissions
  status: UserStatus
}

"""
A freeform stakeholder contact for someone who is not a registered ReARM user.
"""
type ComponentContact {
  name: String
  contact: String
}

"""
A component's stored durable owner reference (a Team/UserGroup or a single user).
"""
type ComponentOwner {
  ownerType: ComponentOwnerType!
  ownerRef: ID!
}

"""
Resolved ownership view of a component (status/durability/derived suggestion).
"""
type ComponentOwnership {
  ownerType: ComponentOwnerType
  ownerRef: ID
  durable: Boolean!
  status: ComponentOwnershipStatus!
  derived: Boolean!
  reason: String
}

"""
One named rule withholding an action until its CEL expression holds.

Guards accumulate rather than override: every guard that applies to an action is evaluated, any
one of them can refuse, and the refusal names the guard that did it. A guard is the mirror of a
release trigger -- same expression language, same release.* variables, plus action.* describing
what is being attempted -- but where a trigger makes something happen, a guard only refuses.
"""
type ActionGuard {
  """
  Names the guard in refusals and in the note a WARN guard leaves behind.
  """
  name: String
  action: GuardedAction
  """
  CEL over release.* and action.*; the action proceeds only while this is true.
  """
  cel: String
  mode: GuardMode
  """
  Java regex matched FULLY against the component name -- `guard-prod` governs the component
  named exactly that, not `guard-prod-api`; write `guard-prod.*` for a prefix. Same anchoring
  as the org's approval-policy and team-assignment rules. Meaningful only on organization-wide
  guards; guards written on a component or a perspective leave it null and are refused if they
  set it.
